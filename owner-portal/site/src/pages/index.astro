---
/*
 * Owner portal — root page.
 * Renders the password gate. If sessionStorage already carries a valid key
 * the AdminGate component redirects to /dashboard inline. noindex always.
 *
 * CSP: strict. Only the owner worker may be contacted. No third-party
 * scripts, no analytics, no external fonts (we inline the stack via
 * tokens.css — same as the public site's fallback rules).
 */
import '../styles/global.css';
import { tokens } from '../lib/tokens';
import OwnerNav from '../components/OwnerNav.astro';
import OwnerFooter from '../components/OwnerFooter.astro';
import AdminGate from '../components/AdminGate.astro';

const apiOrigin = (() => {
  try {
    return new URL(tokens.OWNER_API_URL).origin;
  } catch {
    return '';
  }
})();
const connectSrc = ["'self'", apiOrigin].filter(Boolean).join(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src ${connectSrc}; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'`} />
    <title>{tokens.LISTING_NAME} — Owner sign in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500&display=swap" />
  </head>
  <body class="bg-bg-base text-ink-primary font-sans">
    <OwnerNav />
    <main>
      <AdminGate />
    </main>
    <OwnerFooter />
  </body>
</html>
