---
import { tokens } from '../lib/tokens';
---
<section class="relative h-[92vh] min-h-[680px] overflow-hidden">
  <img
    src={tokens.HERO_PHOTO}
    alt={tokens.GALLERY_ALT[0]}
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-[120%] object-cover hero-parallax"
  />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, rgba(15,14,12,0.45) 0%, rgba(15,14,12,0.10) 22%, rgba(15,14,12,0.05) 50%, rgba(15,14,12,0.55) 76%, rgba(15,14,12,0.94) 100%);"
  ></div>

  <!-- BOTTOM block — CTA only (tagline / price / MLS / address removed) -->
  <div class="absolute inset-x-0 bottom-[64px] md:bottom-[72px] px-[var(--gutter)]">
    <div class="max-w-[var(--max-w)] mx-auto text-center">
      <div class="flex justify-center">
        <a href="/roi" id="hero-cta" class="glass-cta" aria-label="Investment Opportunity — Multiple Revenue Options">
          <span class="glass-cta__main">Investment Opportunity</span>
          <span class="glass-cta__sub">Multiple Revenue Options</span>
        </a>
      </div>
    </div>
  </div>

  <!-- SCROLL indicator -->
  <div class="absolute bottom-3 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-1.5 pointer-events-none">
    <span class="text-[#C0FF00] text-[10px] tracking-[0.4em] uppercase opacity-75">Scroll</span>
    <svg width="14" height="18" viewBox="0 0 14 18" class="opacity-70 animate-bounce" aria-hidden="true">
      <path d="M2 4 L7 9 L12 4 M2 10 L7 15 L12 10" stroke="#C0FF00" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
  </div>
</section>

<!-- THE · VALORA · WAY — centred right below the pool image, no background.
     "THE" / "WAY" flank the outlined VALORA logo in yellow, 25% larger (19px → 23.75px). -->
<div class="px-[var(--gutter)] pt-10 pb-2 md:pt-12 md:pb-3">
  <div class="valora-lockup relative flex items-center justify-center gap-3 sm:gap-5 md:gap-8">
    <span class="hero-flank text-[#C0FF00] text-[29.78px] tracking-[0.4em] uppercase font-light leading-none">The</span>
    <h1 class="hero-outlined-title inline-block text-[2.55rem] sm:text-[3.06rem] md:text-[5.44rem] leading-[0.92] font-light">{tokens.LISTING_NAME}</h1>
    <span class="hero-flank text-[#C0FF00] text-[29.78px] tracking-[0.4em] uppercase font-light leading-none">Way</span>
  </div>
</div>

<!-- Share toast -->
<div
  id="share-toast"
  class="fixed left-1/2 -translate-x-1/2 bottom-24 z-50 bg-bg-elevated border border-[var(--accent-2)]/50 text-ink-primary text-sm px-5 py-3 opacity-0 pointer-events-none transition-opacity duration-300"
  role="status"
  aria-live="polite"
>
  Link copied — paste it anywhere.
</div>

<style>
  .hero-outlined-title {
    color: var(--ink-primary);
    -webkit-text-stroke: 4px #5BC2C2;
    paint-order: stroke fill;
  }
  /* Hover: the lockup eases toward the viewer + a subtle hue illuminates behind it */
  /* Hover: the lockup simply eases toward the viewer — no glow */
  .valora-lockup {
    transform: perspective(900px) translateZ(0);
    transition: transform 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .valora-lockup:hover { transform: perspective(900px) translateZ(45px); }
  /* Two-piece glassmorphism CTA — big frosted panel + a smaller pill below,
     even gap, lime neon trim. Sub piece ≈ 75% width / ~18% height of the main. */
  .glass-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.45));
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), filter 500ms ease;
  }
  .glass-cta__main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 108px;
    padding: 0 clamp(38px, 8vw, 72px);
    border-radius: 26px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: clamp(14px, 2.3vw, 19px);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    background: rgba(255, 255, 255, 0.07);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    backdrop-filter: blur(16px) saturate(1.15);
    box-shadow:
      inset 0 0 0 1.5px rgba(192, 255, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 0 20px rgba(192, 255, 0, 0.15);
    transition: box-shadow 450ms ease;
  }
  .glass-cta__sub {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75%;
    height: 22px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow:
      inset 0 0 0 1.2px rgba(192, 255, 0, 0.5),
      0 0 14px rgba(192, 255, 0, 0.12);
    transition: box-shadow 450ms ease, color 300ms ease;
  }
  .glass-cta:hover { transform: translateY(-5px) scale(1.02); }
  .glass-cta:hover .glass-cta__main {
    box-shadow:
      inset 0 0 0 1.8px #C0FF00,
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      0 0 30px rgba(192, 255, 0, 0.34);
  }
  .glass-cta:hover .glass-cta__sub {
    color: #fff;
    box-shadow: inset 0 0 0 1.6px #C0FF00, 0 0 20px rgba(192, 255, 0, 0.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .glass-cta { transition: none; }
    .glass-cta:hover { transform: none; }
  }
</style>

<script is:inline define:vars={{ title: tokens.LISTING_NAME, blurb: tokens.LISTING_TAGLINE }}>
  // @ts-nocheck
  (function () {
    const toast = document.getElementById('share-toast');
    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.style.opacity = '1';
      setTimeout(() => { toast.style.opacity = '0'; }, 2400);
    }
    document.querySelectorAll('[data-action="share-listing"]').forEach((el) => {
      el.addEventListener('click', async (e) => {
        e.preventDefault();
        const url = location.href;
        if (navigator.share) {
          try {
            await navigator.share({ title, text: blurb, url });
            return;
          } catch (_) {}
        }
        try {
          await navigator.clipboard.writeText(url);
          showToast('Link copied — paste it anywhere.');
        } catch (_) {
          location.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(blurb + '\n\n' + url)}`;
        }
      });
    });
  })();
</script>
