---
import { tokens } from '../lib/tokens';
import OctCTA from './ui/OctCTA.astro';
---
<section class="relative h-[92vh] min-h-[680px] overflow-hidden">
  <img
    src={tokens.HERO_PHOTO}
    alt={tokens.GALLERY_ALT[0]}
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-[120%] object-cover hero-parallax"
  />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, rgba(15,14,12,0.45) 0%, rgba(15,14,12,0.10) 22%, rgba(15,14,12,0.05) 50%, rgba(15,14,12,0.55) 76%, rgba(15,14,12,0.94) 100%);"
  ></div>

  <!-- TOP-LEFT — kicker + property name -->
  <div class="absolute top-0 inset-x-0 px-[var(--gutter)] pt-[88px] md:pt-[100px]">
    <div class="max-w-[var(--max-w)] mx-auto">
      <p class="text-white text-[15.4px] sm:text-[17.6px] tracking-[0.3em] uppercase opacity-95">3341 Broadview Road</p>
    </div>
  </div>

  <!-- BOTTOM block — tagline + price + buttons -->
  <div class="absolute inset-x-0 bottom-[64px] md:bottom-[72px] px-[var(--gutter)]">
    <div class="max-w-[var(--max-w)] mx-auto text-center">
      <p class="text-ink-primary/95 text-[15px] md:text-[26px] mb-2 font-serif italic uppercase tracking-[0.18em] leading-tight">
        {tokens.LISTING_TAGLINE}
      </p>
      <p class="text-ink-muted text-base md:text-xl mb-7 md:mb-9 font-serif italic tracking-[0.12em]">
        {tokens.ASKING_PRICE_DISPLAY} {tokens.CURRENCY} &nbsp;·&nbsp; MLS® {tokens.MLS_NUMBER}
      </p>

      <div class="flex justify-center">
        <OctCTA variant="ghost" href="/roi" id="hero-cta" class="hero-invest-cta">
          <span class="flex flex-col items-center text-center leading-none">
            <span class="text-[15px] md:text-[18px] tracking-[0.2em]">Investment Opportunity</span>
            <span class="text-[9px] md:text-[11px] tracking-[0.26em] opacity-75 mt-2">Multiple Revenue Options</span>
          </span>
        </OctCTA>
      </div>
    </div>
  </div>

  <!-- SCROLL indicator -->
  <div class="absolute bottom-3 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-1.5 pointer-events-none">
    <span class="text-[#C0FF00] text-[10px] tracking-[0.4em] uppercase opacity-75">Scroll</span>
    <svg width="14" height="18" viewBox="0 0 14 18" class="opacity-70 animate-bounce" aria-hidden="true">
      <path d="M2 4 L7 9 L12 4 M2 10 L7 15 L12 10" stroke="#C0FF00" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
  </div>
</section>

<!-- THE · VALORA · WAY — centred right below the pool image, no background.
     "THE" / "WAY" flank the outlined VALORA logo in yellow, 25% larger (19px → 23.75px). -->
<div class="px-[var(--gutter)] pt-10 pb-2 md:pt-12 md:pb-3">
  <div class="flex items-center justify-center gap-3 sm:gap-5 md:gap-8">
    <span class="text-[#C0FF00] text-[28.5px] tracking-[0.4em] uppercase font-light leading-none">The</span>
    <h1 class="hero-outlined-title inline-block text-6xl sm:text-7xl md:text-9xl leading-[0.92] font-light">{tokens.LISTING_NAME}</h1>
    <span class="text-[#C0FF00] text-[28.5px] tracking-[0.4em] uppercase font-light leading-none">Way</span>
  </div>
</div>

<!-- Share toast -->
<div
  id="share-toast"
  class="fixed left-1/2 -translate-x-1/2 bottom-24 z-50 bg-bg-elevated border border-[var(--accent-2)]/50 text-ink-primary text-sm px-5 py-3 opacity-0 pointer-events-none transition-opacity duration-300"
  role="status"
  aria-live="polite"
>
  Link copied — paste it anywhere.
</div>

<style>
  .hero-outlined-title {
    color: var(--ink-primary);
    -webkit-text-stroke: 2px #5BC2C2;
    paint-order: stroke fill;
  }
  /* Taller octagon so the two-line investment label breathes */
  :global(.hero-invest-cta) {
    --h: 84px;
    --pad-x: 46px;
  }
</style>

<script is:inline define:vars={{ title: tokens.LISTING_NAME, blurb: tokens.LISTING_TAGLINE }}>
  // @ts-nocheck
  (function () {
    const toast = document.getElementById('share-toast');
    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.style.opacity = '1';
      setTimeout(() => { toast.style.opacity = '0'; }, 2400);
    }
    document.querySelectorAll('[data-action="share-listing"]').forEach((el) => {
      el.addEventListener('click', async (e) => {
        e.preventDefault();
        const url = location.href;
        if (navigator.share) {
          try {
            await navigator.share({ title, text: blurb, url });
            return;
          } catch (_) {}
        }
        try {
          await navigator.clipboard.writeText(url);
          showToast('Link copied — paste it anywhere.');
        } catch (_) {
          location.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(blurb + '\n\n' + url)}`;
        }
      });
    });
  })();
</script>
