---
/*
 * ScrollDirection — sticky floating octagon button bottom-right.
 *
 * Teal-themed everything (outline, progress arc, glow) — EXCEPT the live
 * percentage readout, which stays lime (#C0FF00) to pop against the cool
 * teal palette around it.
 */
---
<button
  id="scroll-direction-btn"
  class="scroll-dir-btn hidden-init"
  aria-label="Scroll progress — click to jump"
  type="button"
>
  <span class="scroll-dir-base" aria-hidden="true"></span>
  <svg class="scroll-dir-progress" viewBox="0 0 60 60" aria-hidden="true">
    <circle cx="30" cy="30" r="22" fill="none" stroke="rgba(237, 230, 214, 0.18)" stroke-width="2.4"/>
    <circle
      class="scroll-dir-arc"
      cx="30" cy="30" r="22"
      fill="none"
      stroke="#5BC2C2"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-dasharray="138.23"
      stroke-dashoffset="138.23"
      transform="rotate(-90 30 30)"
    />
    <text
      class="scroll-dir-pct"
      x="30" y="34.5"
      text-anchor="middle"
      fill="#C0FF00"
      font-family="var(--font-sans)"
      font-size="13"
      font-weight="500"
      letter-spacing="0.5"
    >0%</text>
  </svg>
</button>

<style>
  .scroll-dir-btn {
    position: fixed;
    bottom: 26px;
    right: 24px;
    z-index: 35;
    width: 58px;
    height: 58px;
    background: transparent;
    border: 0;
    cursor: pointer;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 450ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 450ms cubic-bezier(0.16, 1, 0.3, 1),
                filter 500ms cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 1;
    transform: translateY(0);
    filter: drop-shadow(0 8px 20px rgba(15, 14, 12, 0.45));
  }
  .scroll-dir-btn.hidden-init {
    opacity: 0;
    pointer-events: none;
    transform: translateY(28px);
  }

  .scroll-dir-base {
    position: absolute;
    inset: 0;
    background: #1F2024;
    box-shadow: inset 0 0 0 1.2px rgba(237, 230, 214, 0.55);
    clip-path: polygon(
      12px 0, calc(100% - 12px) 0,
      100% 12px, 100% calc(100% - 12px),
      calc(100% - 12px) 100%, 12px 100%,
      0 calc(100% - 12px), 0 12px
    );
    transition: box-shadow 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-dir-progress {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  /* Lit state — fires on hover OR while scrolling. Outline brightens to teal,
     soft teal halo. % text stays lime for contrast. */
  .scroll-dir-btn:hover,
  .scroll-dir-btn.is-lit {
    filter:
      drop-shadow(0 12px 22px rgba(15, 14, 12, 0.5))
      drop-shadow(0 0 14px rgba(91, 194, 194, 0.40));
  }
  .scroll-dir-btn:hover .scroll-dir-base,
  .scroll-dir-btn.is-lit .scroll-dir-base {
    box-shadow: inset 0 0 0 1.4px #5BC2C2;
  }

  .scroll-dir-btn:active {
    transform: scale(0.95);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-dir-btn,
    .scroll-dir-base {
      transition: none !important;
    }
  }
</style>

<script>
  // @ts-nocheck
  (function () {
    const btn = document.getElementById('scroll-direction-btn');
    const arc = document.querySelector('.scroll-dir-arc');
    const pctText = document.querySelector('.scroll-dir-pct');
    if (!btn) return;

    const ARC_LEN = 2 * Math.PI * 22;
    const NEAR_TOP = 240;
    const NEAR_EDGE = 80;
    const LIT_DECAY = 700;

    let rafId = null;
    let litTimer = null;
    let lastY = window.scrollY;
    let lastDir = 'down';

    function update() {
      const y = window.scrollY;
      const dy = y - lastY;
      lastY = y;

      if (Math.abs(dy) > 3) {
        lastDir = dy > 0 ? 'down' : 'up';
      }

      if (y < NEAR_TOP) btn.classList.add('hidden-init');
      else btn.classList.remove('hidden-init');

      if (y >= NEAR_TOP) {
        btn.classList.add('is-lit');
        clearTimeout(litTimer);
        litTimer = setTimeout(() => btn.classList.remove('is-lit'), LIT_DECAY);
      }

      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const p = Math.min(100, Math.max(0, Math.round((y / max) * 100)));
      if (arc) arc.style.strokeDashoffset = String(ARC_LEN - (p / 100) * ARC_LEN);
      if (pctText) pctText.textContent = `${p}%`;
    }

    window.addEventListener('scroll', () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(update);
    }, { passive: true });

    btn.addEventListener('click', () => {
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      let target;
      if (y <= NEAR_EDGE) target = max;
      else if (max - y <= NEAR_EDGE) target = 0;
      else if (lastDir === 'down') target = max;
      else target = 0;
      window.scrollTo({ top: target, behavior: 'smooth' });
    });

    update();
  })();
</script>
