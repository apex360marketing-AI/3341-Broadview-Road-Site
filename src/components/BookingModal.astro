---
import { tokens } from '../lib/tokens';
import Honeycomb from './Honeycomb.astro';
import DatePicker from './booking/DatePicker.astro';
import OctCTA from './ui/OctCTA.astro';

const inlinePrivacy = `Your details are sent to ${tokens.HOST_NAME} only to respond to this inquiry. When you secure the booking on the next step, a CAD $${tokens.DEPOSIT_AMOUNT_CAD} authorization (not a charge) will be placed on your card. We don't sell your data. Cancellation policy and privacy notice in the footer.`;
const marketingLabel = `Send me occasional updates from ${tokens.HOST_NAME} about availability and Okanagan travel tips. Optional — leaving this unchecked won't affect your inquiry. Unsubscribe anytime.`;
---
<div
  id="booking-modal"
  class="fixed inset-0 z-50 bg-bg-base/95 backdrop-blur-sm hidden items-start sm:items-center justify-center overflow-y-auto py-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="booking-title"
>
  <div class="relative bg-bg-surface w-full max-w-2xl mx-3 sm:mx-4 my-auto border border-ink-faint/30 overflow-hidden">
    <!-- Honeycomb watermark — matches the home page section treatment -->
    <Honeycomb unique="modal" opacity={0.05} />

    <button
      type="button"
      id="booking-close"
      class="absolute top-3 right-3 text-ink-muted hover:text-ink-primary p-2 z-20"
      aria-label="Close booking form"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="relative z-10 px-6 sm:px-8 pt-7 pb-6">
      <p class="text-[var(--accent-2)] text-xs tracking-[0.24em] uppercase mb-2">Inquiry</p>
      <h3 id="booking-title" class="text-2xl sm:text-3xl mb-1">Check Availability</h3>
      <p class="text-ink-muted text-sm">From <span class="text-ink-primary">${tokens.NIGHTLY_RATE_FROM}</span> {tokens.CURRENCY} / night · {tokens.MIN_NIGHTS}-night minimum</p>
    </div>

    <form id="booking-form" novalidate class="relative z-10 px-6 sm:px-8 pb-7 space-y-4">
      <!-- honeypot -->
      <div class="hidden" aria-hidden="true">
        <label>Leave blank: <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-ink-muted text-xs uppercase tracking-[0.18em]">Name *</span>
          <input type="text" name="name" required maxlength="120" class="mt-1.5 w-full bg-bg-base border border-ink-faint/40 px-3 py-2.5 text-ink-primary focus:border-accent" />
        </label>
        <label class="block">
          <span class="text-ink-muted text-xs uppercase tracking-[0.18em]">Email *</span>
          <input type="email" name="email" required class="mt-1.5 w-full bg-bg-base border border-ink-faint/40 px-3 py-2.5 text-ink-primary focus:border-accent" />
        </label>
      </div>

      <label class="block">
        <span class="text-ink-muted text-xs uppercase tracking-[0.18em]">Phone (optional)</span>
        <input type="tel" name="phone" class="mt-1.5 w-full bg-bg-base border border-ink-faint/40 px-3 py-2.5 text-ink-primary focus:border-accent" />
      </label>

      <!-- Custom range picker — emits hidden `checkin` and `checkout` inputs -->
      <div class="block">
        <span class="text-ink-muted text-xs uppercase tracking-[0.18em] mb-1.5 block">Dates *</span>
        <DatePicker />
      </div>

      <label class="block">
        <span class="text-ink-muted text-xs uppercase tracking-[0.18em]">Guests *</span>
        <input type="number" name="guests" required min="1" max={tokens.MAX_GUESTS} value="2" class="mt-1.5 w-full bg-bg-base border border-ink-faint/40 px-3 py-2.5 text-ink-primary focus:border-accent" />
      </label>

      <label class="block">
        <span class="text-ink-muted text-xs uppercase tracking-[0.18em]">Message (optional)</span>
        <textarea name="message" maxlength="2000" rows="3" class="mt-1.5 w-full bg-bg-base border border-ink-faint/40 px-3 py-2.5 text-ink-primary focus:border-accent resize-none"></textarea>
      </label>

      <p class="text-ink-muted text-xs leading-relaxed pt-1" id="booking-privacy">
        {inlinePrivacy} See <a href="#privacy" class="underline">privacy notice</a>.
      </p>

      <label class="flex items-start gap-3 text-ink-muted text-xs leading-relaxed cursor-pointer">
        <input type="checkbox" name="marketing_opt_in" id="marketing-opt-in" class="mt-0.5 accent-accent shrink-0" />
        <span id="marketing-label">{marketingLabel}</span>
      </label>

      <div class="pt-2">
        <OctCTA type="submit" size="md" variant="ghost" fullWidth>Continue to Secure</OctCTA>
      </div>

      <div id="booking-status" class="hidden text-sm" role="status" aria-live="polite"></div>
    </form>
  </div>
</div>

<script is:inline define:vars={{
  apiUrl: tokens.BOOKING_API_URL,
  legacyWebhook: tokens.BOOKING_WEBHOOK_URL,
  hostName: tokens.HOST_NAME,
  hostFirst: tokens.HOST_FIRST_NAME,
  hostEmail: tokens.HOST_EMAIL,
  hostResp: tokens.HOST_RESPONSE_TIME,
  listingId: tokens.LISTING_ID,
  listingName: tokens.LISTING_NAME,
  templateVer: tokens.TEMPLATE_VERSION,
  maxGuests: tokens.MAX_GUESTS,
  minNights: tokens.MIN_NIGHTS,
  depositAmount: tokens.DEPOSIT_AMOUNT_CAD,
  inlinePrivacy,
  marketingLabel
}}>
  // @ts-nocheck — define:vars injects at runtime; TS doesn't see them.
  (function () {
    const modal = document.getElementById('booking-modal');
    const form = document.getElementById('booking-form');
    const closeBtn = document.getElementById('booking-close');
    const status = document.getElementById('booking-status');
    if (!modal || !form || !status) return;

    let openedAt = 0;
    let lastFocus = null;

    const hasApi = () => /^https:\/\//i.test(apiUrl);
    const hasLegacy = () => /^https:\/\//i.test(legacyWebhook);

    function open() {
      lastFocus = document.activeElement;
      openedAt = Date.now();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      modal.querySelector('input[name="name"]')?.focus();
      // If NEITHER booking system is configured, show degraded message + disable submit
      const submitBtn = form.querySelector('button[type="submit"]');
      if (!hasApi() && !hasLegacy()) {
        status.className = 'text-sm text-accent border border-accent/40 p-3';
        status.textContent = `Booking is temporarily unavailable. Please email ${hostFirst} directly at ${hostEmail}.`;
        status.classList.remove('hidden');
        if (submitBtn) submitBtn.setAttribute('disabled', 'true');
      }
    }

    function close() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    document.querySelectorAll('[data-action="open-booking"]').forEach((el) => {
      el.addEventListener('click', (e) => { e.preventDefault(); open(); });
    });
    closeBtn?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => {
      if (modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);

      // Honeypot — silent ignore but show success UI
      if (fd.get('company')) {
        status.className = 'text-sm text-ink-muted';
        status.textContent = `Thanks — ${hostFirst} will reply ${hostResp}.`;
        status.classList.remove('hidden');
        form.reset();
        return;
      }

      // Min time-to-submit (3s)
      if (Date.now() - openedAt < 3000) {
        status.className = 'text-sm text-ink-muted';
        status.textContent = `Thanks — ${hostFirst} will reply ${hostResp}.`;
        status.classList.remove('hidden');
        form.reset();
        return;
      }

      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const checkin = String(fd.get('checkin') || '');
      const checkout = String(fd.get('checkout') || '');
      const guests = parseInt(String(fd.get('guests') || '0'), 10);
      const phone = String(fd.get('phone') || '').trim();
      const message = String(fd.get('message') || '').trim();
      const marketing = !!fd.get('marketing_opt_in');

      // Validation
      const errs = [];
      if (!name) errs.push('Please enter your name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errs.push('Please enter a valid email.');
      if (!checkin || !checkout) errs.push('Please choose both dates.');
      if (checkin && checkout) {
        const inD = new Date(checkin), outD = new Date(checkout);
        const nights = Math.round((outD - inD) / 86400000);
        if (nights < minNights) errs.push(`Minimum stay is ${minNights} nights.`);
      }
      if (!(guests >= 1 && guests <= maxGuests)) errs.push(`Guests must be 1 to ${maxGuests}.`);

      if (errs.length) {
        status.className = 'text-sm text-accent';
        status.textContent = errs.join(' ');
        status.classList.remove('hidden');
        return;
      }

      if (!hasApi() && !hasLegacy()) {
        status.className = 'text-sm text-accent';
        status.textContent = `Booking is temporarily unavailable. Email ${hostFirst} at ${hostEmail}.`;
        status.classList.remove('hidden');
        return;
      }

      const requestId =
        (typeof crypto !== 'undefined' && crypto.randomUUID && crypto.randomUUID()) ||
        String(Date.now()) + '-' + Math.random().toString(36).slice(2, 10);

      status.className = 'text-sm text-ink-muted';
      status.textContent = 'Sending…';
      status.classList.remove('hidden');

      if (hasApi()) {
        // v1.1: POST /book → redirect to /pay for the auth-hold
        const payload = {
          request_id: requestId,
          listing_id: listingId,
          name,
          email,
          phone: phone || null,
          checkin,
          checkout,
          guests,
          message: message || null,
          marketing_opt_in: marketing,
          consent_text_shown: inlinePrivacy,
          honeypot_company: '',
          opened_at: openedAt
        };
        try {
          const ctrl = new AbortController();
          const t = setTimeout(() => ctrl.abort(), 8000);
          const r = await fetch(`${apiUrl.replace(/\/+$/, '')}/book`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Idempotency-Key': requestId
            },
            body: JSON.stringify(payload),
            signal: ctrl.signal
          });
          clearTimeout(t);
          if (!r.ok) throw new Error(`status ${r.status}`);
          const body = await r.json();
          if (!body.booking_id) throw new Error('missing booking_id');
          location.assign(`/pay?id=${encodeURIComponent(body.booking_id)}`);
        } catch (_) {
          status.className = 'text-sm text-accent border border-accent/40 p-3';
          status.textContent = `We couldn't reach the booking system. Please email ${hostFirst} directly at ${hostEmail}.`;
        }
        return;
      }

      // Legacy fallback (v1.0): POST to webhook, show inline success — no /pay redirect
      const legacyPayload = {
        request_id: requestId,
        source: 'str-booking-site:listing-page',
        template_version: templateVer,
        listing_id: listingId,
        listing_name: listingName,
        name,
        email,
        phone: phone || null,
        checkin,
        checkout,
        guests,
        message: message || null,
        consent_text_shown: inlinePrivacy,
        marketing_opt_in: marketing,
        marketing_opt_in_text: marketingLabel,
        submitted_at: new Date().toISOString(),
        user_agent: navigator.userAgent,
        page_url: location.href
      };
      try {
        const ctrl = new AbortController();
        const t = setTimeout(() => ctrl.abort(), 8000);
        const r = await fetch(legacyWebhook, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(legacyPayload),
          signal: ctrl.signal
        });
        clearTimeout(t);
        if (r.ok) {
          status.className = 'text-sm text-ink-primary border border-accent/40 p-3';
          status.textContent = `Thanks — ${hostFirst} will reply ${hostResp}.`;
          form.reset();
        } else {
          throw new Error('non-2xx');
        }
      } catch (_) {
        status.className = 'text-sm text-accent border border-accent/40 p-3';
        status.textContent = `We couldn't reach the booking system. Please email ${hostFirst} directly at ${hostEmail}.`;
      }
    });
  })();
</script>
