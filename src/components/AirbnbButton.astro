---
/*
 * AirbnbButton — CTA that sends guests to the VALORA Airbnb listing.
 * Wired to tokens.AIRBNB_URL. Until that's set the button renders in a
 * "coming soon" disabled state. Drop the link into tokens.json → it's live.
 */
import { tokens } from '../lib/tokens';
interface Props { label?: string; class?: string; }
const { label = 'Book VALORA on Airbnb', class: className = '' } = Astro.props;
const url = tokens.AIRBNB_URL;
const pending = !url;
---
<a
  href={url || '#'}
  class:list={['airbnb-btn', pending && 'is-pending', className]}
  data-airbnb
  {...(url ? { target: '_blank', rel: 'noopener' } : { 'aria-disabled': 'true', title: 'Airbnb link coming soon' })}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 11.5 12 4l9 7.5" /><path d="M5 10.5V20h14v-9.5" /><path d="M10 20v-5h4v5" />
  </svg>
  <span>{label}</span>
</a>

<style>
  .airbnb-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 999px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.05);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1.5px rgba(192, 255, 0, 0.55);
    transition: transform .4s cubic-bezier(.16, 1, .3, 1), box-shadow .3s ease, background .3s ease, color .3s ease;
  }
  .airbnb-btn svg { color: #C0FF00; flex-shrink: 0; transition: transform .4s cubic-bezier(.16, 1, .3, 1); }
  .airbnb-btn:hover {
    transform: translateY(-3px);
    background: rgba(192, 255, 0, 0.1);
    box-shadow: inset 0 0 0 1.6px #C0FF00, 0 0 22px rgba(192, 255, 0, 0.25);
  }
  .airbnb-btn:hover svg { transform: translateY(-2px) scale(1.05); }
  .airbnb-btn.is-pending { opacity: 0.55; cursor: not-allowed; }
  .airbnb-btn.is-pending:hover { transform: none; background: rgba(255,255,255,0.05); box-shadow: inset 0 0 0 1.5px rgba(192,255,0,0.55); }
  @media (prefers-reduced-motion: reduce) { .airbnb-btn, .airbnb-btn svg { transition: none; } }
</style>
