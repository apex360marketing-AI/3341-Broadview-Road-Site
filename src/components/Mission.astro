---
/*
 * Mission — VALORA's positioning. Sits just below the Hero, sets the emotional
 * tone before the at-a-glance facts kick in. Short. Sweet. Punchy.
 */
---
<section class="relative py-10 md:py-14 overflow-hidden">
  <div class="relative z-10 max-w-3xl mx-auto px-[var(--gutter)] text-center">
    <!-- Brand kicker: Fraunces + teal outline + tracked uppercase, matches Nav VALORA logo -->
    <p class="brand-text font-serif text-[22px] md:text-[26px] font-light tracking-[0.3em] uppercase mb-5">THE VALORA WAY</p>
    <!-- Thin teal divider — ~half the width of the kicker text -->
    <div class="mx-auto w-28 md:w-36 h-px bg-[var(--accent-2)]/80 mb-7" aria-hidden="true"></div>
    <!-- Tagline + subtagline reverted to original sizes -->
    <h2 class="text-4xl sm:text-5xl md:text-6xl font-light leading-[1.04] mb-7">
      <span class="italic text-white">A retreat.</span> <span class="italic text-[var(--accent-2)]">Not a rental.</span>
    </h2>
    <p class="text-ink-muted text-lg md:text-2xl font-serif italic leading-relaxed max-w-2xl mx-auto">
      Built for the people you love &mdash; and the summer you don't want to end.
    </p>
  </div>
</section>

<style>
  /* Match the Nav.astro VALORA brand-mark — transparent fill + teal stroke. */
  .brand-text {
    color: var(--ink-primary);
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0.7px var(--accent-2);
  }
</style>
