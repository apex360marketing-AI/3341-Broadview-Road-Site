---
/*
 * Mission — positioning statement just below the Hero.
 */
---
<section class="relative pt-3 pb-10 md:pt-4 md:pb-14 overflow-hidden">
  <div class="relative z-10 max-w-3xl mx-auto px-[var(--gutter)] text-center">
    <div class="mx-auto w-28 md:w-36 h-px bg-[#C0FF00]/80 mb-5" aria-hidden="true"></div>
    <h2 class="text-4xl sm:text-5xl md:text-6xl font-light leading-[1.04] mb-7">
      <span class="italic text-white">A legacy.</span> <span class="italic text-[var(--accent-2)]">Not just a listing.</span>
    </h2>
    <p class="mission-line text-[1.575rem] md:text-[2.1rem] font-serif italic leading-relaxed max-w-3xl mx-auto">
      Built for those who know exactly what they're looking for.
    </p>
  </div>
</section>

<style>
  /* Match the VALORA logo look — white fill with a very subtle blue (teal) outline. */
  .mission-line {
    color: #FFFFFF;
    -webkit-text-stroke: 0.4px rgba(91, 194, 194, 0.4);
    paint-order: stroke fill;
  }
</style>
