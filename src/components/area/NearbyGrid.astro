---
import { tokens } from '../../lib/tokens';
import { NEARBY, NEARBY_GROUPS } from '../../data/nearby';
import { haversineMiles } from '../../lib/distance';
import Icon from '../ui/Icon.astro';

// Pre-compute distance for each item from VALORA's coordinates
const ITEMS = NEARBY.map((item) => ({
  ...item,
  distanceMiles: haversineMiles(
    tokens.LISTING_LAT,
    tokens.LISTING_LNG,
    item.lat,
    item.lng
  )
}));

// Group + sort. Restaurants sort by rating (then distance). Others sort by distance.
const GROUPED = NEARBY_GROUPS.map((group) => {
  let items = ITEMS.filter((i) => i.category === group.id);
  if (group.id === 'restaurants') {
    items = items.sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0) || a.distanceMiles - b.distanceMiles);
  } else {
    items = items.sort((a, b) => a.distanceMiles - b.distanceMiles);
  }
  return { ...group, items };
});

function formatDist(mi: number) {
  return mi < 1 ? `${(mi * 5280 / 1000).toFixed(0)} m` : `${mi.toFixed(1)} mi`;
}
---
<section class="py-10 md:py-14">
  <div class="max-w-[var(--max-w)] mx-auto px-[var(--gutter)]">
    <p class="text-[var(--accent-2)] text-xs tracking-[0.24em] uppercase mb-3">What's Nearby</p>
    <h2 class="text-3xl md:text-5xl mb-3 font-light leading-[1.05]">
      The Okanagan, <span class="italic text-[var(--accent-2)]">at your door.</span>
    </h2>
    <p class="text-ink-muted text-lg max-w-2xl font-serif italic mb-10 md:mb-14">
      Hand-picked wineries, beaches, restaurants, hikes, and family adventures &mdash; all within an easy drive.
    </p>

    <div class="space-y-12 md:space-y-16">
      {GROUPED.map((group) => (
        <div>
          <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
            <div>
              <h3 class="text-2xl md:text-3xl font-light tracking-[0.02em] uppercase mb-1">{group.label}</h3>
              <p class="text-ink-muted text-sm font-serif italic">{group.intro}</p>
            </div>
            <p class="text-[var(--accent-2)] text-[10px] tracking-[0.3em] uppercase opacity-80">{group.items.length} spots</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
            {group.items.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="nb-card relative block p-5 group"
              >
                <span class="nb-base" aria-hidden="true"></span>
                <span class="nb-glow" aria-hidden="true"></span>
                <span class="relative z-10 block">
                  <span class="flex items-center justify-between gap-3 mb-3">
                    <span class="flex items-center gap-2.5 text-[var(--accent-2)]">
                      <Icon name={item.icon || group.icon} size={18} />
                      {item.local && (
                        <span class="text-[9px] tracking-[0.18em] uppercase border border-[var(--accent-2)]/55 px-1.5 py-0.5">Local</span>
                      )}
                    </span>
                    {item.rating !== undefined && (
                      <span class="flex items-center gap-1 text-[var(--accent-2)] text-xs">
                        <Icon name="star" size={11} />
                        <span class="text-ink-primary font-medium">{item.rating.toFixed(1)}</span>
                      </span>
                    )}
                  </span>
                  <h4 class="font-serif text-xl md:text-2xl font-light text-ink-primary mb-2 leading-tight">{item.name}</h4>
                  <p class="text-ink-muted text-sm leading-relaxed mb-4 min-h-[3em]">{item.blurb}</p>
                  <span class="flex items-center justify-between text-[10px] tracking-[0.18em] uppercase">
                    <span class="text-[var(--accent-2)] opacity-80">{formatDist(item.distanceMiles)}</span>
                    <span class="text-ink-muted opacity-70">Visit <span class="text-[var(--accent-2)] group-hover:text-white transition-colors">→</span></span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Nearby cards — same OctCTA DNA: octagon-chamfered base + full hover stack
     (cursor-track radial, shimmer sweep, dual halo, dark-grey fill, teal outline). */
  .nb-card {
    --mx: 50%;
    --my: 50%;
    isolation: isolate;
    transition: filter 500ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 6px 14px rgba(15, 14, 12, 0.30));
  }
  .nb-base,
  .nb-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: polygon(
      14px 0, calc(100% - 14px) 0,
      100% 14px, 100% calc(100% - 14px),
      calc(100% - 14px) 100%, 14px 100%,
      0 calc(100% - 14px), 0 14px
    );
  }
  .nb-base {
    z-index: 0;
    background: transparent;
    box-shadow: inset 0 0 0 1.2px rgba(237, 230, 214, 0.45);
    transition: background-color 350ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nb-glow {
    z-index: 1;
    background: radial-gradient(260px circle at var(--mx) var(--my), #5BC2C2 0%, transparent 62%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .nb-card:hover {
    transform: translateY(-2px);
    filter:
      drop-shadow(0 12px 22px rgba(15, 14, 12, 0.45))
      drop-shadow(0 0 18px rgba(91, 194, 194, 0.4))
      drop-shadow(0 0 5px rgba(91, 194, 194, 0.3));
  }
  .nb-card:hover .nb-base {
    background: #1F2024;
    box-shadow: inset 0 0 0 1.4px #5BC2C2;
  }
  .nb-card:hover .nb-glow { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .nb-card, .nb-base, .nb-glow {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // @ts-nocheck
  document.querySelectorAll('.nb-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mx', `${x}%`);
      card.style.setProperty('--my', `${y}%`);
    });
    card.addEventListener('mouseleave', () => {
      card.style.setProperty('--mx', '50%');
      card.style.setProperty('--my', '50%');
    });
  });
</script>
