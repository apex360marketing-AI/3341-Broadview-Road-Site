---
/**
 * Concept 2 — Compass Bloom
 * Trigger: mini compass dial echoing the brand mark. Needle twitches on hover.
 * Open: dial rotates 90deg. Menu items emerge as cardinal indicators (N · E · S · W).
 */
import { MENU_ITEMS } from './items';
const id = 'compassbloom';
const panelId = `${id}-panel`;
const cardinals = ['N', 'E', 'S', 'W'];
---
<div class="cb-menu" data-menu-id={id}>
  <button
    type="button"
    class="cb-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={panelId}
    aria-label="Open menu — Compass Bloom"
    title="Compass Bloom"
  >
    <span class="cb-num" aria-hidden="true">2</span>
    <svg class="cb-dial" width="22" height="22" viewBox="0 0 60 60" aria-hidden="true">
      <circle cx="30" cy="30" r="28" fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-width="0.7"/>
      <circle cx="30" cy="30" r="22" fill="none" stroke="currentColor" stroke-opacity="0.55" stroke-width="0.6"/>
      <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <line x1="30" y1="9" x2="30" y2="13"/><line x1="30" y1="47" x2="30" y2="51"/>
        <line x1="9" y1="30" x2="13" y2="30"/><line x1="47" y1="30" x2="51" y2="30"/>
      </g>
      <path d="M27.5 13.5 L30 10.5 L32.5 13.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="30" cy="30" r="2.4" fill="currentColor"/>
    </svg>
  </button>

  <div class="cb-panel" id={panelId} role="menu" hidden>
    {MENU_ITEMS.map((item, i) => (
      <div class="cb-row" style={`--cb-i: ${i}`}>
        <span class="cb-cardinal" aria-hidden="true">{cardinals[i]}</span>
        {item.dataAction ? (
          <button type="button" class="cb-item" role="menuitem" data-action={item.dataAction}>{item.label}</button>
        ) : item.soon ? (
          <span class="cb-item cb-item-soon" role="menuitem" aria-disabled="true">{item.label}<span class="cb-soon">SOON</span></span>
        ) : (
          <a class="cb-item" role="menuitem" href={item.href}>{item.label}</a>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .cb-menu { position: relative; }
  .cb-trigger {
    position: relative;
    width: 44px; height: 44px;
    color: var(--accent-2);
    background: transparent;
    border: 1px solid rgba(91, 194, 194, 0.30);
    cursor: pointer;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 250ms ease, color 250ms ease;
  }
  .cb-trigger:hover, .cb-trigger[aria-expanded="true"] { color: #fff; border-color: var(--accent-2); }
  .cb-num {
    position: absolute;
    top: -2px; left: -2px;
    width: 14px; height: 14px;
    background: var(--bg-base);
    border: 1px solid rgba(91, 194, 194, 0.3);
    border-radius: 50%;
    font-size: 8px;
    line-height: 12px;
    color: var(--ink-muted);
    opacity: 0.7;
  }

  .cb-dial { transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1); transform-origin: center; transform-box: fill-box; }
  .cb-trigger:hover .cb-dial { transform: rotate(8deg); }
  .cb-trigger[aria-expanded="true"] .cb-dial { transform: rotate(90deg); }

  .cb-panel {
    position: absolute;
    top: calc(100% + 10px); right: 0;
    width: 220px;
    background: #1F2024;
    border: 1px solid rgba(91, 194, 194, 0.35);
    padding: 8px 8px 10px;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1), transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 14px 30px rgba(15, 14, 12, 0.55), 0 0 22px rgba(91, 194, 194, 0.25);
    z-index: 50;
  }
  .cb-panel[hidden] { display: none; }
  .cb-panel.cb-open { opacity: 1; transform: translateY(0); }

  .cb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--cb-i) * 70ms + 100ms);
  }
  .cb-panel.cb-open .cb-row { opacity: 1; transform: translateX(0); }

  .cb-cardinal {
    font-family: var(--font-serif);
    color: var(--accent-2);
    width: 16px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.1em;
    opacity: 0.75;
  }
  .cb-item {
    flex: 1;
    display: block;
    padding: 8px 10px;
    color: var(--ink-primary);
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }
  .cb-item:hover, .cb-item:focus-visible { background: rgba(91, 194, 194, 0.12); color: var(--accent-2); outline: none; }
  .cb-item-soon { color: var(--ink-muted); opacity: 0.55; cursor: not-allowed; pointer-events: none; }
  .cb-soon { float: right; font-size: 9px; color: var(--accent-2); letter-spacing: 0.18em; margin-top: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .cb-dial, .cb-panel, .cb-row { transition: opacity 100ms ease; transform: none !important; }
  }
</style>

<script>
  // @ts-nocheck
  (function(){
    const root = document.querySelector('[data-menu-id="compassbloom"]');
    if (!root) return;
    const trigger = root.querySelector('.cb-trigger');
    const panel = root.querySelector('.cb-panel');
    const items = root.querySelectorAll('.cb-item:not(.cb-item-soon)');
    let openedAt = 0;

    function open() {
      trigger.setAttribute('aria-expanded', 'true');
      panel.removeAttribute('hidden');
      requestAnimationFrame(() => panel.classList.add('cb-open'));
      openedAt = Date.now();
      window.dispatchEvent(new CustomEvent('menu:opened', { detail: { id: 'compassbloom' } }));
      setTimeout(() => items[0]?.focus(), 380);
    }
    function close() {
      trigger.setAttribute('aria-expanded', 'false');
      panel.classList.remove('cb-open');
      setTimeout(() => panel.setAttribute('hidden', ''), 320);
    }
    trigger.addEventListener('click', () => {
      trigger.getAttribute('aria-expanded') === 'true' ? close() : open();
    });
    document.addEventListener('click', (e) => {
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      if (Date.now() - openedAt < 200) return;
      if (!root.contains(e.target)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      if (e.key === 'Escape') { close(); trigger.focus(); }
      if (e.key === 'ArrowDown') { e.preventDefault(); const i = Array.from(items).indexOf(document.activeElement); items[(i + 1) % items.length]?.focus(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); const i = Array.from(items).indexOf(document.activeElement); items[(i - 1 + items.length) % items.length]?.focus(); }
    });
    window.addEventListener('menu:opened', (e) => {
      if (e.detail?.id !== 'compassbloom' && trigger.getAttribute('aria-expanded') === 'true') close();
    });
  })();
</script>
