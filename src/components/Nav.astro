---
import { tokens } from '../lib/tokens';
---
<nav class="fixed top-0 inset-x-0 z-40 bg-gradient-to-b from-black/40 via-black/10 to-transparent">
  <div class="relative max-w-[var(--max-w)] mx-auto px-[var(--gutter)] h-20 flex items-center justify-end">
    <button type="button" class="nav-contact" data-action="open-inquiry" aria-label="Contact Kevin">
      <span class="ck-text">Contact Kevin</span>
    </button>
  </div>

  <!-- Compass (= Home) + VALORA, with a radial fan menu -->
  <div class="brand-menu">
    <a href="/" class="brand-link" aria-label="Home — VALORA">
      <svg class="brand-compass shrink-0" width="156" height="156" viewBox="0 0 60 60" aria-hidden="true">
        <circle cx="30" cy="30" r="28" fill="none" stroke="#5BC2C2" stroke-opacity="1" stroke-width="2.2"/>
        <circle cx="30" cy="30" r="28" fill="none" stroke="#FFFFFF" stroke-opacity="0.92" stroke-width="1.0"/>
        <circle cx="30" cy="30" r="21" fill="none" stroke="#5BC2C2" stroke-opacity="1" stroke-width="2.0"/>
        <circle cx="30" cy="30" r="21" fill="none" stroke="#FFFFFF" stroke-opacity="0.92" stroke-width="0.9"/>
        <g stroke="#FFFFFF" stroke-opacity="0.85" stroke-width="0.9" stroke-linecap="round">
          <line x1="30" y1="5" x2="30" y2="2"/><line x1="55" y1="30" x2="58" y2="30"/>
          <line x1="30" y1="55" x2="30" y2="58"/><line x1="5" y1="30" x2="2" y2="30"/>
          <line x1="48.39" y1="11.62" x2="49.80" y2="10.20"/><line x1="48.39" y1="48.39" x2="49.80" y2="49.80"/>
          <line x1="11.62" y1="48.39" x2="10.20" y2="49.80"/><line x1="11.62" y1="11.62" x2="10.20" y2="10.20"/>
        </g>
        <g class="dial-compass">
          <path d="M30,30 L29.24,28.15 L30,16 Z M30,30 L30.77,28.15 L34.6,25.4 Z M30,30 L31.85,29.24 L44,30 Z M30,30 L31.85,30.77 L34.6,34.6 Z M30,30 L30.77,31.85 L30,44 Z M30,30 L29.24,31.85 L25.4,34.6 Z M30,30 L28.15,30.77 L16,30 Z M30,30 L28.15,29.24 L25.4,25.4 Z" fill="#EDE6D6"/>
          <path d="M30,30 L30,16 L30.77,28.15 Z M30,30 L34.6,25.4 L31.85,29.24 Z M30,30 L44,30 L31.85,30.77 Z M30,30 L34.6,34.6 L30.77,31.85 Z M30,30 L30,44 L29.24,31.85 Z M30,30 L25.4,34.6 L28.15,30.77 Z M30,30 L16,30 L28.15,29.24 Z M30,30 L25.4,25.4 L29.24,28.15 Z" fill="#5BC2C2"/>
        </g>
        <text class="cardinal" x="30" y="11.5" text-anchor="middle" dominant-baseline="middle">N</text>
        <text class="cardinal" x="48.5" y="30" text-anchor="middle" dominant-baseline="middle">E</text>
        <text class="cardinal" x="30" y="48.5" text-anchor="middle" dominant-baseline="middle">S</text>
        <text class="cardinal" x="11.5" y="30" text-anchor="middle" dominant-baseline="middle">W</text>
      </svg>
      <span class="brand-text font-serif text-[2.77rem] font-light">{tokens.LISTING_NAME}</span>
    </a>

    <!-- Radial fan menu — swings out on hover, neon-outline on each item -->
    <div class="radial-menu">
      <a class="rad-item" style="--i:0" href="/area">The Area</a>
      <a class="rad-item" style="--i:1" href="/roi">Investor ROI</a>
      <a class="rad-item" style="--i:2" href="/#mortgage">Mortgage</a>
    </div>
  </div>

  <style>
    @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }

    .brand-menu { position: absolute; top: 0; left: 0; z-index: 41; }
    .brand-link { position: relative; display: block; cursor: pointer; }
    .brand-compass { display: block; position: absolute; top: -25px; left: -25px; z-index: 1; }
    .cardinal { fill: #FFFFFF; font-family: var(--font-serif); font-size: 4.5px; font-weight: 400; opacity: 0.92; }

    /* Top-right "Contact Kevin" — elongated corner brackets (14) that close + glow (11) */
    .nav-contact {
      position: relative;
      width: 178px;
      height: 40px;
      border-radius: 8px;
      background: transparent;
      border: 0;
      cursor: pointer;
      transition: box-shadow .45s ease;
    }
    .nav-contact::before, .nav-contact::after {
      content: '';
      position: absolute;
      width: 14px; height: 14px;
      border: 1.6px solid #C0FF00;
      pointer-events: none;
      transition: width .5s cubic-bezier(.16, 1, .3, 1), height .5s cubic-bezier(.16, 1, .3, 1), box-shadow .4s ease;
    }
    .nav-contact::before { top: 3px; left: 3px; border-right: 0; border-bottom: 0; border-top-left-radius: 6px; }
    .nav-contact::after { bottom: 3px; right: 3px; border-left: 0; border-top: 0; border-bottom-right-radius: 6px; }
    /* Hover: brackets close into the full rectangle + it glows */
    .nav-contact:hover::before, .nav-contact:hover::after {
      width: calc(100% - 6px);
      height: calc(100% - 6px);
      box-shadow: 0 0 9px rgba(192, 255, 0, 0.55);
    }
    .nav-contact:hover { box-shadow: 0 0 20px rgba(192, 255, 0, 0.3); }
    /* "Contact Kevin" wipes in left→right, centred — smooth, no stepping */
    .ck-text {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #C0FF00;
      font-size: 11.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
      clip-path: inset(0 100% 0 0);
      transition: clip-path .6s cubic-bezier(.16, 1, .3, 1) .12s;
    }
    .nav-contact:hover .ck-text { clip-path: inset(0 0 0 0); }

    /* VALORA — vertical, just below the compass */
    .brand-text {
      position: absolute;
      top: 130px;
      left: 53px;
      writing-mode: vertical-rl;
      text-orientation: upright;
      letter-spacing: 0.14em;
      color: #FFFFFF;
      -webkit-text-stroke: 3px #5BC2C2;
      paint-order: stroke fill;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      transform-origin: center top;
      transform: translateX(-50%) perspective(520px) translateZ(0);
      transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1), text-shadow 480ms ease;
      will-change: transform;
    }
    .brand-menu:hover .brand-text {
      transform: translateX(-50%) perspective(520px) translateZ(15px);
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5), 0 0 4px rgba(91, 194, 194, 0.85), 0 0 9px rgba(91, 194, 194, 0.5);
    }
    .brand-link svg {
      color: #EDE6D6;
      filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.5));
      transform-origin: center;
      transform: perspective(520px) translateZ(0);
      transition: filter 450ms cubic-bezier(0.16, 1, 0.3, 1), transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .brand-menu:hover .brand-link svg { transform: perspective(520px) translateZ(22px); }
    .dial-compass { transform-box: view-box; transform-origin: 30px 30px; }
    .brand-link svg.is-spinning {
      filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 12px rgba(91, 194, 194, 0.65));
    }

    /* ===== Radial fan (concept 1) with concept-4 neon items ===== */
    .radial-menu { position: absolute; top: 53px; left: 53px; z-index: 60; pointer-events: none; }
    .rad-item {
      --ang: calc(var(--i) * 24deg);
      position: absolute;
      left: 0; top: 0;
      padding: 9px 15px;
      border-radius: 10px;
      color: #fff;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      text-decoration: none;
      /* completely see-through glass — the neon outline reveals the shape on hover only */
      background: transparent;
      -webkit-backdrop-filter: blur(5px);
      backdrop-filter: blur(5px);
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
      /* collapsed at the compass centre */
      transform: translate(-50%, -50%) rotate(var(--ang)) translateX(0) rotate(calc(-1 * var(--ang)));
      opacity: 0;
      pointer-events: none;
      transition: transform .55s cubic-bezier(.16, 1, .3, 1), opacity .4s ease, color .25s ease, box-shadow .3s ease;
    }
    .brand-menu.open .rad-item {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, -50%) rotate(var(--ang)) translateX(148px) rotate(calc(-1 * var(--ang)));
      transition-delay: calc(var(--i) * 0.05s);
    }
    .rad-item:hover { color: #C0FF00; z-index: 5; }
    /* Concept 4 — spinning neon outline, one at a time (only the hovered item) */
    .rad-item::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 10px;
      padding: 1.5px;
      background: conic-gradient(from var(--a), transparent 0 55%, #C0FF00 78%, #5BC2C2 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s ease;
      animation: rad-spin 3s linear infinite;
    }
    .rad-item:hover::before { opacity: 1; }
    @keyframes rad-spin { to { --a: 360deg; } }

    @media (prefers-reduced-motion: reduce) {
      .rad-item, .rad-item::before, .brand-text, .brand-link svg { transition: none; animation: none; }
    }
  </style>
</nav>

<script>
  // @ts-nocheck
  // Compass spin + glow on scroll
  const compass = document.querySelector('.dial-compass');
  const compassSvg = document.querySelector('.brand-link svg');
  if (compass) {
    let rot = 0, lastY = window.scrollY, rafId = null, litTimer = null;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      window.addEventListener('scroll', () => {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const y = window.scrollY;
          rot += (y - lastY) * 0.5;
          lastY = y;
          compass.style.transform = `rotate(${rot}deg)`;
          if (compassSvg) {
            compassSvg.classList.add('is-spinning');
            if (litTimer) clearTimeout(litTimer);
            litTimer = window.setTimeout(() => compassSvg.classList.remove('is-spinning'), 650);
          }
        });
      }, { passive: true });
    }
  }

  // Radial fan open/close — hover to fan out; a small close delay bridges the gap
  const menu = document.querySelector('.brand-menu');
  if (menu) {
    let closeT;
    menu.addEventListener('mouseenter', () => { clearTimeout(closeT); menu.classList.add('open'); });
    menu.addEventListener('mouseleave', () => { closeT = setTimeout(() => menu.classList.remove('open'), 240); });
  }
</script>
