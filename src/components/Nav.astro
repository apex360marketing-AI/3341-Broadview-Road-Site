---
import { tokens } from '../lib/tokens';
---
<nav class="fixed top-0 inset-x-0 z-40 backdrop-blur-md bg-[#1F2024]/90 border-b border-[var(--accent-2)]/20">
  <div class="relative max-w-[var(--max-w)] mx-auto px-[var(--gutter)] h-20 flex items-center justify-between">

    <!-- ===== LEFT: Compass dial + VALORA brand ===== -->
    <a href="/" class="brand-link flex items-center gap-3 md:gap-4 group">
      <svg width="37" height="37" viewBox="0 0 60 60" aria-hidden="true" class="shrink-0">
        <circle cx="30" cy="30" r="28" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.2"/>
        <g stroke="currentColor" stroke-opacity="0.95" stroke-width="2.1" stroke-linecap="round">
          <line x1="30" y1="0.5" x2="30" y2="3.5"/><line x1="30" y1="56.5" x2="30" y2="59.5"/>
          <line x1="0.5" y1="30" x2="3.5" y2="30"/><line x1="56.5" y1="30" x2="59.5" y2="30"/>
        </g>
        <g class="dial-compass">
          <circle cx="30" cy="30" r="22" fill="none" stroke="currentColor" stroke-opacity="0.75" stroke-width="1.1"/>
          <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
            <line x1="30" y1="9" x2="30" y2="13"/><line x1="30" y1="47" x2="30" y2="51"/>
            <line x1="9" y1="30" x2="13" y2="30"/><line x1="47" y1="30" x2="51" y2="30"/>
          </g>
          <g stroke="currentColor" stroke-width="1.5" stroke-opacity="1" stroke-linecap="round">
            <line x1="40.6" y1="11.84" x2="42.5" y2="14.5"/><line x1="48.16" y1="19.4" x2="45.5" y2="21.3"/>
            <line x1="48.16" y1="40.6" x2="45.5" y2="38.7"/><line x1="40.6" y1="48.16" x2="42.5" y2="45.5"/>
            <line x1="19.4" y1="48.16" x2="17.5" y2="45.5"/><line x1="11.84" y1="40.6" x2="14.5" y2="38.7"/>
            <line x1="11.84" y1="19.4" x2="14.5" y2="21.3"/><line x1="19.4" y1="11.84" x2="17.5" y2="14.5"/>
          </g>
          <path d="M27 14 L30 10 L33 14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
        <circle cx="30" cy="30" r="3.1" fill="currentColor"/>
        <circle cx="30" cy="30" r="1" fill="#1F2024"/>
      </svg>
      <span class="brand-text font-serif text-[2.15rem] md:text-[2.76rem] font-light tracking-[0.05em] leading-none">
        {tokens.LISTING_NAME}
      </span>
    </a>

    <!-- ===== RIGHT: nav links ===== -->
    <div class="flex items-center gap-7 sm:gap-8 text-sm tracking-wide">
      <a href="#property" class="text-[#C0FF00] hover:text-white transition-colors hidden lg:inline uppercase tracking-[0.14em] text-[11px]">The Property</a>
      <a href="/area" class="text-[#C0FF00] hover:text-white transition-colors hidden lg:inline uppercase tracking-[0.14em] text-[11px]">The Area</a>
      <a href="/roi" class="text-[#C0FF00] hover:text-white transition-colors hidden lg:inline uppercase tracking-[0.14em] text-[11px]">Investor ROI</a>
      <a href="#contact" class="text-[var(--accent-2)] uppercase tracking-[0.18em] text-[11px] hover:text-[#7DD8D8] transition-colors" data-action="open-inquiry">Contact Agent</a>
    </div>
  </div>

  <style>
    .brand-text {
      color: var(--ink-primary);
      -webkit-text-fill-color: transparent;
      -webkit-text-stroke: 0.7px var(--accent-2);
    }
    .brand-link svg {
      /* Rest: ~30% darker than the teal accent (#5BC2C2 → #408888) for a bolder,
         more grounded compass that still reads as brand teal. */
      color: #408888;
      transition: filter 450ms cubic-bezier(0.16, 1, 0.3, 1), color 500ms ease;
    }
    /* Spin the compass around its own centre (30,30 in the 60×60 viewBox).
       Without this, CSS rotation pivots on the viewBox corner and the compass
       swings off-canvas — the reason the scroll effect looked dead. */
    .dial-compass {
      transform-box: view-box;
      transform-origin: 30px 30px;
    }
    /* "Activated" while scrolling — lights up to full brand teal + soft glow,
       then settles back to the darker rest colour after scrolling stops. */
    .brand-link svg.is-spinning {
      color: #5BC2C2;
      filter: drop-shadow(0 0 7px rgba(91, 194, 194, 0.6));
    }
  </style>
</nav>

<script>
  // @ts-nocheck
  const compass = document.querySelector('.dial-compass') as SVGGElement | null;
  const compassSvg = document.querySelector('.brand-link svg') as SVGElement | null;
  if (compass) {
    let rot = 0;
    let lastY = window.scrollY;
    let rafId: number | null = null;
    let litTimer: number | null = null;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      window.addEventListener('scroll', () => {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const y = window.scrollY;
          rot += (y - lastY) * 1.0;
          lastY = y;
          compass.style.transform = `rotate(${rot}deg)`;
          // Light the compass up while scrolling, decay back after it stops.
          if (compassSvg) {
            compassSvg.classList.add('is-spinning');
            if (litTimer) clearTimeout(litTimer);
            litTimer = window.setTimeout(() => compassSvg.classList.remove('is-spinning'), 650);
          }
        });
      }, { passive: true });
    }
  }
</script>
