---
import { getEntry, render } from 'astro:content';
import Honeycomb from './Honeycomb.astro';

const entry = await getEntry('static', 'about');
const { Content } = entry ? await render(entry) : { Content: null };
---
<section class="relative py-10 md:py-14 bg-transparent overflow-hidden">
  <Honeycomb opacity={0.04} />
  <div class="relative z-10 max-w-3xl mx-auto px-[var(--gutter)]">
    <p class="text-[var(--accent-2)] text-xs tracking-[0.24em] uppercase mb-3">About this place</p>
    <div class="prose prose-lg prose-invert max-w-none font-serif text-ink-primary [&_p]:text-lg [&_p]:md:text-xl [&_p]:leading-relaxed [&_p]:mb-5 [&_strong]:text-accent">
      {Content && <Content />}
    </div>
  </div>
</section>
