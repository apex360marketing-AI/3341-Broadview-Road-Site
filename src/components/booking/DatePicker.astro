---
/**
 * DatePicker — brand-consistent custom range picker.
 *
 * Renders two stacked month panels (single month on mobile). User clicks
 * dates to set check-in then check-out; range is highlighted in between.
 *
 * No third-party dependencies. Outputs to two hidden <input>s named
 * `checkin` and `checkout` so existing FormData-based submit logic works.
 *
 * Availability: on mount, the script attempts to fetch
 * `${BOOKING_API_URL}/availability?...&listing_id=...` and applies the
 * returned `blocked_dates` array. If the URL isn't set or the request fails,
 * the picker stays open with all future dates available (degraded mode).
 *
 * Min-nights enforced from tokens.MIN_NIGHTS.
 * Past dates and blocked dates are non-interactive.
 */
import { tokens } from '../../lib/tokens';
---
<div
  class="dp-root"
  role="group"
  aria-label="Select check-in and check-out dates"
  data-min-nights={tokens.MIN_NIGHTS}
  data-listing-id={tokens.LISTING_ID}
  data-api-url={tokens.BOOKING_API_URL}
>
  <!-- Visible selection pills -->
  <div class="dp-selection">
    <div class="dp-pill" data-side="checkin">
      <span class="dp-pill-label">Check-in</span>
      <span class="dp-pill-value" data-empty-text="Select date">Select date</span>
    </div>
    <span class="dp-pill-arrow" aria-hidden="true">→</span>
    <div class="dp-pill" data-side="checkout">
      <span class="dp-pill-label">Check-out</span>
      <span class="dp-pill-value" data-empty-text="Select date">Select date</span>
    </div>
    <div class="dp-pill dp-pill-stat" data-side="nights">
      <span class="dp-pill-label">Nights</span>
      <span class="dp-pill-value">—</span>
    </div>
  </div>

  <!-- Hidden inputs that integrate with existing form FormData reads -->
  <input type="hidden" name="checkin" value="" required />
  <input type="hidden" name="checkout" value="" required />

  <!-- Status / errors -->
  <p class="dp-status" role="status" aria-live="polite"></p>

  <!-- Calendar panels (built by JS at mount) -->
  <div class="dp-panels" role="application">
    <div class="dp-panel" data-month-offset="0"></div>
    <div class="dp-panel dp-panel-second" data-month-offset="1"></div>
  </div>
</div>

<style>
  .dp-root {
    font-family: var(--font-sans);
  }
  .dp-selection {
    display: grid;
    grid-template-columns: 1fr auto 1fr 1fr;
    gap: 8px;
    align-items: center;
    margin-bottom: 10px;
  }
  .dp-pill {
    background: var(--bg-base);
    border: 1px solid rgba(237, 230, 214, 0.20);
    padding: 8px 10px;
    transition: border-color 200ms ease;
  }
  .dp-pill[data-state="filled"] { border-color: var(--accent-2); }
  .dp-pill-stat { border-style: dashed; }
  .dp-pill-arrow {
    color: var(--ink-muted);
    text-align: center;
    font-size: 14px;
    opacity: 0.7;
  }
  .dp-pill-label {
    display: block;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 2px;
  }
  .dp-pill-value {
    display: block;
    font-size: 12px;
    color: var(--ink-primary);
    font-feature-settings: 'tnum';
  }
  .dp-pill[data-state="empty"] .dp-pill-value { color: var(--ink-muted); opacity: 0.7; }

  .dp-status {
    min-height: 16px;
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--accent-2);
    margin: 0 0 8px;
  }
  .dp-status.dp-status-error { color: #E07070; }

  .dp-panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .dp-panels { grid-template-columns: 1fr 1fr; gap: 16px; }
  }

  .dp-panel {
    background: var(--bg-base);
    border: 1px solid rgba(237, 230, 214, 0.12);
    padding: 10px;
    user-select: none;
  }
  .dp-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 0 4px;
  }
  .dp-month-label {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--ink-primary);
    text-transform: uppercase;
    flex: 1;
    text-align: center;
  }
  .dp-nav-btn {
    width: 28px; height: 28px;
    background: transparent;
    border: 1px solid rgba(91, 194, 194, 0.25);
    color: var(--accent-2);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .dp-nav-btn:hover:not(:disabled) { border-color: var(--accent-2); color: #fff; }
  .dp-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .dp-nav-btn-invisible { visibility: hidden; }

  .dp-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    margin-bottom: 4px;
  }
  .dp-weekdays span {
    text-align: center;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 4px 0;
  }

  .dp-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }
  .dp-cell {
    aspect-ratio: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: var(--ink-primary);
    font-size: 12px;
    font-feature-settings: 'tnum';
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
    position: relative;
  }
  .dp-cell:hover:not(:disabled):not(.dp-cell-empty) {
    background: rgba(91, 194, 194, 0.12);
    color: var(--accent-2);
  }
  .dp-cell:focus-visible {
    outline: 2px solid var(--accent-2);
    outline-offset: -2px;
  }
  .dp-cell:disabled, .dp-cell-blocked {
    color: var(--ink-faint);
    cursor: not-allowed;
    text-decoration: line-through;
    text-decoration-color: var(--ink-faint);
  }
  .dp-cell-past {
    color: var(--ink-faint);
    cursor: not-allowed;
    opacity: 0.4;
  }
  .dp-cell-empty { visibility: hidden; pointer-events: none; }

  .dp-cell-checkin,
  .dp-cell-checkout {
    background: var(--accent-2) !important;
    color: var(--bg-base) !important;
    font-weight: 600;
  }
  .dp-cell-in-range {
    background: rgba(91, 194, 194, 0.18);
    color: var(--accent-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .dp-cell, .dp-nav-btn { transition: none; }
  }
</style>

<script>
  // @ts-nocheck
  /**
   * DatePicker client logic.
   * Pure JS, no deps. Renders 2 panels on init; supports prev/next nav, range
   * selection, hover preview, blocked-date enforcement, min-nights check.
   */
  (function () {
    const root = document.querySelector('.dp-root');
    if (!root) return;

    const minNights = parseInt(root.dataset.minNights || '1', 10);
    const listingId = root.dataset.listingId || '';
    const apiUrl = (root.dataset.apiUrl || '').replace(/\/+$/, '');
    const todayIso = new Date().toISOString().slice(0, 10);

    /** State */
    let firstMonthOffset = 0;     // 0 = current month
    let blocked = new Set();      // Set<YYYY-MM-DD>
    let checkin = null;            // YYYY-MM-DD
    let checkout = null;           // YYYY-MM-DD
    let hoverDate = null;          // YYYY-MM-DD for range preview

    const pillCheckin = root.querySelector('.dp-pill[data-side="checkin"]');
    const pillCheckout = root.querySelector('.dp-pill[data-side="checkout"]');
    const pillNights = root.querySelector('.dp-pill[data-side="nights"]');
    const inputCheckin = root.querySelector('input[name="checkin"]');
    const inputCheckout = root.querySelector('input[name="checkout"]');
    const statusEl = root.querySelector('.dp-status');

    function fmt(date) {
      const y = date.getFullYear();
      const m = String(date.getMonth() + 1).padStart(2, '0');
      const d = String(date.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }
    function fromIso(iso) {
      const [y, m, d] = iso.split('-').map(Number);
      return new Date(y, m - 1, d);
    }
    function diffDays(aIso, bIso) {
      const a = fromIso(aIso), b = fromIso(bIso);
      return Math.round((b.getTime() - a.getTime()) / 86400000);
    }
    function monthLabel(year, month) {
      return new Date(year, month, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    }

    /** Render one panel. monthOffset is relative to current month. */
    function renderPanel(panelEl, monthOffset) {
      const base = new Date();
      base.setDate(1);
      base.setMonth(base.getMonth() + monthOffset);
      const year = base.getFullYear();
      const month = base.getMonth();

      const firstDay = new Date(year, month, 1).getDay(); // 0=Sun
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      const isFirst = monthOffset === firstMonthOffset;
      const isSecond = monthOffset === firstMonthOffset + 1;

      panelEl.innerHTML = `
        <div class="dp-panel-header">
          <button type="button" class="dp-nav-btn ${isFirst ? '' : 'dp-nav-btn-invisible'}" data-action="prev" aria-label="Previous month">&lsaquo;</button>
          <h4 class="dp-month-label">${monthLabel(year, month)}</h4>
          <button type="button" class="dp-nav-btn ${isSecond ? '' : 'dp-nav-btn-invisible'}" data-action="next" aria-label="Next month">&rsaquo;</button>
        </div>
        <div class="dp-weekdays" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="dp-grid" role="grid"></div>
      `;

      const grid = panelEl.querySelector('.dp-grid');

      // Empty leading cells
      for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement('span');
        empty.className = 'dp-cell dp-cell-empty';
        grid.appendChild(empty);
      }

      // Day cells
      for (let d = 1; d <= daysInMonth; d++) {
        const date = new Date(year, month, d);
        const iso = fmt(date);
        const isPast = iso < todayIso;
        const isBlocked = blocked.has(iso);
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'dp-cell';
        cell.dataset.date = iso;
        cell.textContent = String(d);
        cell.setAttribute('role', 'gridcell');
        cell.setAttribute('aria-label', date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }));

        if (isPast) {
          cell.classList.add('dp-cell-past');
          cell.disabled = true;
        } else if (isBlocked) {
          cell.classList.add('dp-cell-blocked');
          cell.disabled = true;
        }

        applyRangeClasses(cell, iso);
        grid.appendChild(cell);
      }
    }

    function applyRangeClasses(cell, iso) {
      cell.classList.remove('dp-cell-checkin', 'dp-cell-checkout', 'dp-cell-in-range');
      if (checkin && iso === checkin) cell.classList.add('dp-cell-checkin');
      if (checkout && iso === checkout) cell.classList.add('dp-cell-checkout');
      // Confirmed range: between checkin and checkout
      if (checkin && checkout && iso > checkin && iso < checkout) {
        cell.classList.add('dp-cell-in-range');
      }
      // Hover preview: between checkin and hoverDate when checkout not set
      if (checkin && !checkout && hoverDate && hoverDate > checkin && iso > checkin && iso < hoverDate) {
        cell.classList.add('dp-cell-in-range');
      }
    }

    function refreshRangeStyles() {
      root.querySelectorAll('.dp-cell[data-date]').forEach((cell) => {
        applyRangeClasses(cell, cell.dataset.date);
      });
    }

    function renderAll() {
      const panels = root.querySelectorAll('.dp-panel');
      panels.forEach((p) => {
        const offset = firstMonthOffset + parseInt(p.dataset.monthOffset, 10);
        renderPanel(p, offset);
      });
    }

    function setStatus(msg, isError = false) {
      statusEl.textContent = msg || '';
      statusEl.classList.toggle('dp-status-error', !!isError);
    }

    function updatePills() {
      const setPill = (pill, iso) => {
        const valueEl = pill.querySelector('.dp-pill-value');
        if (iso) {
          valueEl.textContent = fromIso(iso).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
          pill.dataset.state = 'filled';
        } else {
          valueEl.textContent = valueEl.dataset.emptyText || 'Select date';
          pill.dataset.state = 'empty';
        }
      };
      setPill(pillCheckin, checkin);
      setPill(pillCheckout, checkout);
      const nightsValue = pillNights.querySelector('.dp-pill-value');
      nightsValue.textContent = (checkin && checkout) ? String(diffDays(checkin, checkout)) : '—';
    }

    function selectDate(iso) {
      // If no checkin OR clicked date is before checkin → set as new checkin, clear checkout
      if (!checkin || iso < checkin) {
        checkin = iso;
        checkout = null;
        setStatus(`Select check-out (minimum ${minNights} night${minNights === 1 ? '' : 's'})`);
      } else if (iso === checkin) {
        // Clicking the same checkin date — reset
        checkin = null;
        checkout = null;
        setStatus('');
      } else {
        // Validate min nights
        const nights = diffDays(checkin, iso);
        if (nights < minNights) {
          setStatus(`Minimum stay is ${minNights} night${minNights === 1 ? '' : 's'}`, true);
          return;
        }
        // Check no blocked date is inside the range
        for (let d = fromIso(checkin); fmt(d) < iso; d.setDate(d.getDate() + 1)) {
          if (blocked.has(fmt(d))) {
            setStatus('Selected range includes unavailable dates — please choose another range', true);
            return;
          }
        }
        checkout = iso;
        setStatus(`${diffDays(checkin, checkout)} nights · ${fromIso(checkin).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} → ${fromIso(checkout).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`);
      }
      inputCheckin.value = checkin || '';
      inputCheckout.value = checkout || '';
      updatePills();
      refreshRangeStyles();
      // Notify any external listener (BookingModal validation, etc.)
      root.dispatchEvent(new CustomEvent('datepicker:change', { detail: { checkin, checkout }, bubbles: true }));
    }

    // Event delegation
    root.addEventListener('click', (e) => {
      const navBtn = e.target.closest('[data-action]');
      if (navBtn) {
        if (navBtn.dataset.action === 'prev') firstMonthOffset = Math.max(0, firstMonthOffset - 1);
        if (navBtn.dataset.action === 'next') firstMonthOffset += 1;
        renderAll();
        return;
      }
      const cell = e.target.closest('.dp-cell[data-date]:not([disabled])');
      if (cell) selectDate(cell.dataset.date);
    });

    root.addEventListener('mouseover', (e) => {
      const cell = e.target.closest('.dp-cell[data-date]:not([disabled])');
      if (!cell || !checkin || checkout) return;
      hoverDate = cell.dataset.date;
      refreshRangeStyles();
    });
    root.addEventListener('mouseleave', () => {
      hoverDate = null;
      refreshRangeStyles();
    });

    /** Initial fetch — only if BOOKING_API_URL is set */
    async function loadAvailability() {
      if (!apiUrl) return;
      const from = todayIso;
      const to = (() => {
        const t = new Date();
        t.setDate(t.getDate() + 90);
        return fmt(t);
      })();
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 5000);
        const r = await fetch(`${apiUrl}/availability?from=${from}&to=${to}&listing_id=${encodeURIComponent(listingId)}`, { signal: ctrl.signal });
        clearTimeout(timer);
        if (!r.ok) return;
        const data = await r.json();
        if (Array.isArray(data.blocked_dates)) {
          blocked = new Set(data.blocked_dates);
          renderAll();
          if (data.source === 'degraded') {
            setStatus('Live availability unavailable — host will confirm within 24h');
          }
        }
      } catch (_) {
        // Silent failure — calendar still works in all-available mode
      }
    }

    renderAll();
    updatePills();
    loadAvailability();
  })();
</script>
