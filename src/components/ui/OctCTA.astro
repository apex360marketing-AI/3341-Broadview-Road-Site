---
/*
 * LineCTA — minimal transparent CTA with a hairline lime outline.
 *
 * Rest:  fully transparent, ~1px lime (#C0FF00) hairline outline, sharp corners.
 * Hover: the button lifts toward the viewer (translateY + scale), the lime line
 *        thickens slightly and blooms a soft lime glow. No fill, no arrow.
 *
 * The outline is drawn with an inset box-shadow (not `border`) so thickening it
 * on hover causes zero layout shift.
 *
 * Sizes: lg (60px H) · md (52px) · sm (44px). fullWidth stretches inline.
 * Reduced motion: the lift is disabled, the glow/thicken still reads.
 *
 * (Filename kept as OctCTA for import compatibility across the 6 call sites.)
 */
type Props = {
  size?: 'lg' | 'md' | 'sm';
  variant?: 'solid' | 'ghost';
  id?: string;
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  fullWidth?: boolean;
  'data-action'?: string;
};

const {
  size = 'lg',
  id,
  href,
  type = 'button',
  class: className = '',
  fullWidth = false,
  ...rest
} = Astro.props;

const sizeClass = `line-${size}`;
const cls = ['line-cta', sizeClass, fullWidth && 'line-full', className];
---
{href ? (
  <a href={href} id={id} class:list={cls} {...rest}>
    <span class="line-cta__text"><slot /></span>
  </a>
) : (
  <button type={type} id={id} class:list={cls} {...rest}>
    <span class="line-cta__text"><slot /></span>
  </button>
)}

<style>
  .line-cta {
    --h: 60px;
    --pad-x: 42px;
    --line: #C0FF00;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--h);
    padding: 0 var(--pad-x);
    background: transparent;
    color: var(--ink-primary);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border: 0;
    border-radius: 2px;
    cursor: pointer;
    isolation: isolate;
    /* Hairline lime outline — inset shadow so thickening it never shifts layout */
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--line) 80%, transparent);
    transition:
      transform 460ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 380ms cubic-bezier(0.16, 1, 0.3, 1),
      letter-spacing 460ms cubic-bezier(0.16, 1, 0.3, 1),
      color 300ms ease;
    will-change: transform;
  }

  .line-cta.line-md { --h: 52px; --pad-x: 34px; font-size: 12px; }
  .line-cta.line-sm { --h: 44px; --pad-x: 26px; font-size: 11px; letter-spacing: 0.16em; }
  .line-cta.line-full { display: flex; width: 100%; }

  .line-cta__text {
    position: relative;
    z-index: 1;
    display: inline-flex;
  }

  /* HOVER — lifts toward you, the lime line thickens + blooms a soft glow */
  .line-cta:hover,
  .line-cta:focus-visible {
    transform: translateY(-6px) scale(1.045);
    letter-spacing: 0.235em;
    color: #FFFFFF;
    box-shadow:
      inset 0 0 0 1.8px var(--line),
      0 0 10px rgba(192, 255, 0, 0.38),
      0 0 26px rgba(192, 255, 0, 0.18),
      0 18px 34px rgba(15, 14, 12, 0.45);
  }
  .line-cta.line-sm:hover,
  .line-cta.line-sm:focus-visible { transform: translateY(-4px) scale(1.05); }

  .line-cta:active { transform: translateY(-2px) scale(0.99); }

  .line-cta:focus-visible {
    outline: 2px solid transparent;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .line-cta { transition-duration: 0.01ms; }
    .line-cta:hover,
    .line-cta:focus-visible { transform: none; }
  }
</style>
