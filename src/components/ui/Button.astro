---
type Props = {
  href?: string;
  variant?: 'primary' | 'ghost';
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
  'data-action'?: string;
};

const { href, variant = 'primary', type = 'button', class: className = '', id, ...rest } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 px-6 py-3 text-sm tracking-wide uppercase font-medium transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-3';

const variantClass =
  variant === 'primary'
    ? 'bg-accent text-bg-base hover:bg-accent-hover active:bg-accent-deep'
    : 'border border-ink-faint text-ink-primary hover:border-accent hover:text-accent';

const cls = `${base} ${variantClass} ${className}`;
---
{href ? (
  <a href={href} class={cls} id={id} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={cls} id={id} {...rest}>
    <slot />
  </button>
)}
