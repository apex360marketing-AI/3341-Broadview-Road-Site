---
/*
 * GlassCard — elongated glass-morphism panel with an attached "pill" CTA.
 *
 * At rest: frosted semi-transparent glass so the hero image shows through,
 * with a faint cream hairline border. On hover: a lime (#C0FF00 — the site's
 * VALORA accent) neon rim ignites on BOTH the panel and the pill, the card
 * lifts, and the pill arrow advances. The whole card is the click target
 * (the pill is the visible "click forward" affordance).
 *
 * Props:
 *   title — short headline, rendered in lime.
 *   line  — one clean supporting line, rendered in silver/cream.
 *   pill  — short pill label (keep to 1–2 words).
 *   href  — navigation target.
 */
type Props = {
  title: string;
  line: string;
  pill: string;
  href: string;
};

const { title, line, pill, href } = Astro.props;
---
<a href={href} class="glass-card">
  <span class="glass-base" aria-hidden="true"></span>
  <span class="glass-content">
    <span class="glass-title">{title}</span>
    <span class="glass-line">{line}</span>
    <span class="glass-pill">
      <span class="glass-pill-label">{pill}</span>
      <svg width="26" height="10" viewBox="0 0 26 10" fill="none" aria-hidden="true" class="glass-pill-arrow">
        <line x1="0" y1="5" x2="20" y2="5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <path d="M16 1 L23 5 L16 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </span>
  </span>
</a>

<style>
  .glass-card {
    position: relative;
    display: block;
    width: 100%;
    max-width: 440px;
    padding: 20px 26px;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
    text-align: left;
    color: var(--ink-primary);
    transition:
      transform 450ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Frosted glass layer — semi-transparent so the hero shows through. */
  .glass-base {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(14px) saturate(118%);
    backdrop-filter: blur(14px) saturate(118%);
    border: 1px solid rgba(237, 230, 214, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10);
    transition:
      border-color 350ms ease,
      box-shadow 450ms cubic-bezier(0.16, 1, 0.3, 1),
      background 350ms ease;
  }

  .glass-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .glass-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.005em;
    color: #C0FF00;
  }

  .glass-line {
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: rgba(237, 230, 214, 0.82);
  }

  /* Pill — the "click forward" affordance, attached at the bottom-left. */
  .glass-pill {
    margin-top: 16px;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(237, 230, 214, 0.22);
    font-size: 10.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-primary);
    transition:
      border-color 350ms ease,
      box-shadow 400ms cubic-bezier(0.16, 1, 0.3, 1),
      background 350ms ease;
  }

  .glass-pill-arrow {
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ===== HOVER — lime rim ignites on the panel AND the pill ===== */
  .glass-card:hover {
    transform: translateY(-3px);
  }
  .glass-card:hover .glass-base {
    border-color: #C0FF00;
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 1px #C0FF00,
      0 0 24px rgba(192, 255, 0, 0.45),
      inset 0 0 20px rgba(192, 255, 0, 0.08);
  }
  .glass-card:hover .glass-pill {
    border-color: #C0FF00;
    background: rgba(192, 255, 0, 0.06);
    box-shadow:
      0 0 0 1px #C0FF00,
      0 0 16px rgba(192, 255, 0, 0.40);
  }
  .glass-card:hover .glass-pill-arrow {
    transform: translateX(5px);
  }

  .glass-card:active {
    transform: translateY(-1px) scale(0.99);
  }
  .glass-card:focus-visible {
    outline: 2px solid #C0FF00;
    outline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-card,
    .glass-base,
    .glass-pill,
    .glass-pill-arrow {
      transition-duration: 0.01ms !important;
    }
  }
</style>
