---
import { tokens } from '../lib/tokens';
import OctCTA from './ui/OctCTA.astro';
---
<div class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-bg-base/95 backdrop-blur-md border-t border-ink-faint/30">
  <div class="flex items-center justify-between px-4 py-3 gap-3">
    <div>
      <div class="text-ink-primary text-sm font-medium">{tokens.ASKING_PRICE_DISPLAY} {tokens.CURRENCY}</div>
      <div class="text-ink-muted text-xs">MLS® {tokens.MLS_NUMBER}</div>
    </div>
    <OctCTA size="sm" variant="ghost" class="sticky-cta-yellow" data-action="open-inquiry">Contact Agent</OctCTA>
  </div>
</div>

<style is:global>
  /* Bottom sticky bar — render the "Contact Agent" label in the brand lime. */
  .sticky-cta-yellow .oct-text { color: #C0FF00; }
</style>
