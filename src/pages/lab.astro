---
/*
 * Design Lab — pick-and-choose showcase (not linked in the live nav).
 * 5 transparent unified-menu header concepts + 10 buttons
 * (Set A: 5 styles sharing ONE hover · Set B: 5 unique hovers).
 * Tell me the ones you want and I'll wire them into the live site.
 */
import '../styles/global.css';
const links = ['The Property', 'The Area', 'Investor ROI', 'Contact'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design Lab — VALORA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500;600&display=swap" />
  </head>
  <body class="bg-bg-base text-ink-primary font-sans">
    <main class="max-w-[1180px] mx-auto px-6 py-16">
      <header class="mb-16">
        <p class="text-[#C0FF00] text-xs tracking-[0.4em] uppercase mb-3">VALORA · Design Lab</p>
        <h1 class="text-4xl md:text-6xl font-light leading-tight">Pick your look.</h1>
        <p class="text-ink-muted mt-4 max-w-2xl">Five transparent header concepts and ten buttons. Hover everything. Then just tell me e.g. <span class="text-[#C0FF00]">"Header 3, buttons A2 + B4"</span> and I'll ship them to the live site.</p>
      </header>

      <!-- ============ HEADERS ============ -->
      <h2 class="text-2xl font-light mb-6 pb-3 border-b border-white/10">Header concepts <span class="text-ink-faint text-base">— transparent · all four links in one bar</span></h2>

      <!-- Each header sits on a photo so you can judge the transparency -->
      {[
        { n: 1, name: 'Glass Pill', cls: 'hd-glass', note: 'Frosted glass capsule, blur + hairline edge' },
        { n: 2, name: 'Neon Underline', cls: 'hd-underline', note: 'Flat + animated lime underline sweep' },
        { n: 3, name: 'Segmented Rail', cls: 'hd-rail', note: 'Outlined capsule, dividers, segment fills on hover' },
        { n: 4, name: 'Sliding Marker', cls: 'hd-dot', note: 'Lime marker slides under the hovered link' },
        { n: 5, name: 'Bracketed Mono', cls: 'hd-bracket', note: 'Architectural corner brackets, mono tracking' },
      ].map((h) => (
        <section class="mb-8">
          <div class="flex items-baseline gap-3 mb-2">
            <span class="text-[#C0FF00] font-semibold">Header {h.n}</span>
            <span class="text-ink-primary">{h.name}</span>
            <span class="text-ink-faint text-sm">— {h.note}</span>
          </div>
          <div class="hd-stage">
            <img src="/listing/photo-03.jpg" alt="" class="hd-bg" />
            <div class:list={['hd-bar', h.cls]}>
              <span class="hd-brand">VALORA</span>
              <nav class="hd-links">
                {links.map((l) => <a href="#" class="hd-link">{l}</a>)}
              </nav>
            </div>
          </div>
        </section>
      ))}

      <!-- ============ BUTTONS ============ -->
      <h2 class="text-2xl font-light mt-20 mb-6 pb-3 border-b border-white/10">Buttons</h2>

      <h3 class="text-lg text-[#C0FF00] tracking-wide mb-5">Set A — five styles, one shared hover <span class="text-ink-faint text-sm">(sheen sweep + lift + lime edge-glow)</span></h3>
      <div class="btn-grid mb-16">
        <div class="btn-cell"><button class="btnA a1"><span>Book a Showing</span></button><em>A1 · Hairline</em></div>
        <div class="btn-cell"><button class="btnA a2"><span>Book a Showing</span></button><em>A2 · Glass pill</em></div>
        <div class="btn-cell"><button class="btnA a3"><span>Book a Showing</span></button><em>A3 · Filled dark</em></div>
        <div class="btn-cell"><button class="btnA a4"><span>Book a Showing</span></button><em>A4 · Double frame</em></div>
        <div class="btn-cell"><button class="btnA a5"><span>Book a Showing</span></button><em>A5 · Wide chamfer</em></div>
      </div>

      <h3 class="text-lg text-[#C0FF00] tracking-wide mb-5">Set B — five unique hovers <span class="text-ink-faint text-sm">(hover each)</span></h3>
      <div class="btn-grid">
        <div class="btn-cell"><button class="btnB b1"><span>Book a Showing</span></button><em>B1 · Fill wipe → invert</em></div>
        <div class="btn-cell"><button class="btnB b2"><span>Book a Showing</span></button><em>B2 · Spinning gradient edge</em></div>
        <div class="btn-cell"><button class="btnB b3"><span data-txt="Book a Showing">Book a Showing</span></button><em>B3 · Label slide-swap</em></div>
        <div class="btn-cell"><button class="btnB b4"><span>Book a Showing</span></button><em>B4 · Pulsing glow ring</em></div>
        <div class="btn-cell"><button class="btnB b5"><span>Book a Showing</span></button><em>B5 · Corner-bracket draw</em></div>
      </div>

      <!-- ============ DROPDOWN MENUS ============ -->
      <h2 class="text-2xl font-light mt-20 mb-6 pb-3 border-b border-white/10">Dropdown menus <span class="text-ink-faint text-base">— 10 distinct transparent designs · shown open to compare · hover the items</span></h2>
      <div class="dd-grid">
        {[
          { n: 1, name: 'Minimal glass', cls: 'dd-1' },
          { n: 2, name: 'Lime left-rail', cls: 'dd-2' },
          { n: 3, name: 'Two-column mega', cls: 'dd-3' },
          { n: 4, name: 'Iconed dots', cls: 'dd-4' },
          { n: 5, name: 'Underline sweep', cls: 'dd-5' },
          { n: 6, name: 'Gradient fill', cls: 'dd-6' },
          { n: 7, name: 'Card tiles', cls: 'dd-7' },
          { n: 8, name: 'Numbered', cls: 'dd-8' },
          { n: 9, name: 'Outlined pills', cls: 'dd-9' },
          { n: 10, name: 'Arrow reveal', cls: 'dd-10' },
        ].map((d) => (
          <div class="dd-cell">
            <div class:list={['dd', d.cls]}>
              <button class="dd-trigger" type="button">Menu <span class="dd-caret">▾</span></button>
              <div class="dd-menu">
                <a href="#">The Property</a>
                <a href="#">The Area</a>
                <a href="#">Investor ROI</a>
                <a href="#">Contact</a>
              </div>
            </div>
            <em>{d.n}. {d.name}</em>
          </div>
        ))}
      </div>
    </main>

    <style>
      :root { --lime: #C0FF00; --teal: #5BC2C2; }

      /* ---------- dropdown menus — 10 DISTINCT transparent designs (shown open) ---------- */
      .dd-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px 26px; align-items: start; }
      .dd-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
      .dd-cell em { font-style: normal; color: var(--ink-faint); font-size: 12px; }
      .dd { position: relative; width: 100%; max-width: 250px; }
      .dd-trigger {
        width: 100%; text-align: left; padding: 10px 18px; border-radius: 10px; cursor: pointer;
        color: #fff; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
        display: flex; align-items: center; justify-content: space-between;
        background: rgba(255,255,255,0.05); box-shadow: inset 0 0 0 1px rgba(192,255,0,0.5);
      }
      .dd-caret { color: var(--lime); }

      /* Base menu — transparent glass, shown OPEN so designs are comparable */
      .dd-menu {
        margin-top: 8px; padding: 8px; display: flex; flex-direction: column; gap: 2px;
        background: rgba(255,255,255,0.05);
        -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
        border-radius: 14px;
        box-shadow: inset 0 0 0 1px rgba(192,255,0,0.28), 0 18px 36px rgba(0,0,0,0.45);
      }
      .dd-menu a {
        position: relative; padding: 11px 14px; border-radius: 8px; color: #fff; font-size: 12px;
        letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap;
        transition: all .25s ease;
      }

      /* 1 · Minimal glass */
      .dd-1 .dd-menu a:hover { background: rgba(192,255,0,0.14); color: var(--lime); }

      /* 2 · Lime left-rail */
      .dd-2 .dd-menu { padding-left: 16px; }
      .dd-2 .dd-menu::before { content:''; position:absolute; left:7px; top:12px; bottom:12px; width:2px; background: var(--lime); border-radius:2px; box-shadow:0 0 8px rgba(192,255,0,0.5); }
      .dd-2 .dd-menu a:hover { transform: translateX(6px); color: var(--lime); }

      /* 3 · Two-column mega */
      .dd-3 .dd-menu { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
      .dd-3 .dd-menu a { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1); }
      .dd-3 .dd-menu a:hover { background: rgba(91,194,194,0.16); box-shadow: inset 0 0 0 1px var(--teal); }

      /* 4 · Iconed dots */
      .dd-4 .dd-menu a { padding-left: 36px; }
      .dd-4 .dd-menu a::before { content:''; position:absolute; left:14px; top:50%; transform:translateY(-50%); width:7px; height:7px; border-radius:50%; border:1.5px solid var(--teal); transition: all .25s ease; }
      .dd-4 .dd-menu a:hover { color: var(--lime); }
      .dd-4 .dd-menu a:hover::before { background: var(--lime); border-color: var(--lime); box-shadow:0 0 8px var(--lime); }

      /* 5 · Underline sweep */
      .dd-5 .dd-menu a::after { content:''; position:absolute; left:14px; right:14px; bottom:7px; height:1.5px; background: var(--lime); transform: scaleX(0); transform-origin:left; transition: transform .3s ease; }
      .dd-5 .dd-menu a:hover { color: var(--lime); }
      .dd-5 .dd-menu a:hover::after { transform: scaleX(1); }

      /* 6 · Gradient fill */
      .dd-6 .dd-menu a:hover { background: linear-gradient(100deg, var(--teal), var(--lime)); color:#0F0E0C; font-weight:600; }

      /* 7 · Card tiles */
      .dd-7 .dd-menu { gap: 6px; }
      .dd-7 .dd-menu a { background: rgba(255,255,255,0.04); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12); }
      .dd-7 .dd-menu a:hover { box-shadow: inset 0 0 0 1.4px var(--lime); transform: translateY(-2px); color: var(--lime); }

      /* 8 · Numbered */
      .dd-8 .dd-menu { counter-reset: ddn; }
      .dd-8 .dd-menu a { padding-left: 42px; }
      .dd-8 .dd-menu a::before { counter-increment: ddn; content: '0' counter(ddn); position:absolute; left:14px; top:50%; transform:translateY(-50%); color: var(--lime); font-size:10px; letter-spacing:0.1em; opacity:0.85; }
      .dd-8 .dd-menu a:hover { color: var(--lime); }

      /* 9 · Outlined pills */
      .dd-9 .dd-menu a { border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(237,230,214,0.3); margin: 1px 0; }
      .dd-9 .dd-menu a:hover { box-shadow: inset 0 0 0 1.4px var(--lime); color: var(--lime); }

      /* 10 · Arrow reveal */
      .dd-10 .dd-menu a { padding-right: 36px; }
      .dd-10 .dd-menu a::after { content:'\2192'; position:absolute; right:16px; top:50%; transform: translate(6px,-50%); color: var(--lime); opacity:0; transition: all .25s ease; }
      .dd-10 .dd-menu a:hover { color: var(--lime); }
      .dd-10 .dd-menu a:hover::after { opacity:1; transform: translate(0,-50%); }

      /* ---------- header stage ---------- */
      .hd-stage { position: relative; height: 108px; border-radius: 12px; overflow: hidden; }
      .hd-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .hd-bar {
        position: absolute; inset: 0; display: flex; align-items: center;
        justify-content: space-between; padding: 0 22px; gap: 20px;
      }
      .hd-brand {
        font-family: var(--font-serif); font-size: 26px; font-weight: 300; letter-spacing: 0.05em;
        color: transparent; -webkit-text-stroke: 0.7px var(--teal);
      }
      .hd-links { display: flex; align-items: center; gap: 4px; }
      .hd-link {
        position: relative; color: #fff; font-size: 12px; letter-spacing: 0.16em;
        text-transform: uppercase; padding: 9px 15px; white-space: nowrap;
        transition: color .3s ease;
      }

      /* H1 · Glass pill */
      .hd-glass .hd-links {
        gap: 2px; padding: 6px; border-radius: 999px;
        background: rgba(255,255,255,0.08); backdrop-filter: blur(14px);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.22);
      }
      .hd-glass .hd-link { border-radius: 999px; transition: background .3s ease, color .3s ease; }
      .hd-glass .hd-link:hover { background: rgba(192,255,0,0.16); color: var(--lime); }

      /* H2 · Neon underline */
      .hd-underline .hd-link::after {
        content: ''; position: absolute; left: 15px; right: 15px; bottom: 4px; height: 1.5px;
        background: var(--lime); transform: scaleX(0); transform-origin: left; transition: transform .4s cubic-bezier(.16,1,.3,1);
      }
      .hd-underline .hd-link:hover { color: var(--lime); }
      .hd-underline .hd-link:hover::after { transform: scaleX(1); }

      /* H3 · Segmented rail */
      .hd-rail .hd-links { border: 1px solid rgba(255,255,255,0.35); border-radius: 8px; overflow: hidden; gap: 0; }
      .hd-rail .hd-link + .hd-link { border-left: 1px solid rgba(255,255,255,0.22); }
      .hd-rail .hd-link:hover { background: rgba(192,255,0,0.14); color: var(--lime); }

      /* H4 · Sliding marker */
      .hd-dot .hd-link::before {
        content: ''; position: absolute; left: 50%; bottom: 3px; width: 5px; height: 5px; border-radius: 50%;
        background: var(--lime); opacity: 0; transform: translate(-50%, 6px); transition: all .35s cubic-bezier(.16,1,.3,1);
      }
      .hd-dot .hd-link:hover { color: var(--lime); }
      .hd-dot .hd-link:hover::before { opacity: 1; transform: translate(-50%, 0); }

      /* H5 · Bracketed mono */
      .hd-bracket .hd-links { position: relative; padding: 8px 16px; }
      .hd-bracket .hd-links::before, .hd-bracket .hd-links::after {
        content: ''; position: absolute; width: 14px; height: 14px; border: 1.5px solid var(--lime);
      }
      .hd-bracket .hd-links::before { top: 0; left: 0; border-right: 0; border-bottom: 0; }
      .hd-bracket .hd-links::after { bottom: 0; right: 0; border-left: 0; border-top: 0; }
      .hd-bracket .hd-link { letter-spacing: 0.22em; }
      .hd-bracket .hd-link:hover { color: var(--lime); text-shadow: 0 0 10px rgba(192,255,0,0.5); }

      /* ---------- button grids ---------- */
      .btn-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 26px; }
      .btn-cell { display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .btn-cell em { font-style: normal; color: var(--ink-faint); font-size: 12px; letter-spacing: 0.04em; }
      .btnA, .btnB {
        position: relative; isolation: isolate; overflow: hidden;
        height: 54px; padding: 0 30px; border: 0; cursor: pointer;
        color: #fff; font-family: var(--font-sans); font-size: 12px; font-weight: 500;
        letter-spacing: 0.18em; text-transform: uppercase; background: transparent;
        transition: transform .45s cubic-bezier(.16,1,.3,1), box-shadow .4s ease, letter-spacing .45s ease, color .3s ease;
      }
      .btnA span, .btnB span { position: relative; z-index: 2; display: inline-block; }

      /* ===== Set A — shared hover ===== */
      .btnA::before { /* sheen */
        content: ''; position: absolute; inset: 0; z-index: 1;
        background: linear-gradient(110deg, transparent 30%, rgba(192,255,0,0.28) 50%, transparent 70%);
        transform: translateX(-120%); transition: transform .8s cubic-bezier(.16,1,.3,1);
      }
      .btnA:hover { transform: translateY(-5px) scale(1.03); letter-spacing: 0.24em;
        box-shadow: 0 0 12px rgba(192,255,0,0.4), 0 18px 34px rgba(0,0,0,0.5); }
      .btnA:hover::before { transform: translateX(120%); }
      .a1 { box-shadow: inset 0 0 0 1px rgba(192,255,0,0.8); }
      .a2 { border-radius: 999px; background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.22); }
      .a3 { background: #16181c; box-shadow: inset 0 0 0 1px rgba(192,255,0,0.35); color: var(--lime); }
      .a4 { box-shadow: inset 0 0 0 1px var(--lime), inset 0 0 0 5px rgba(0,0,0,0.4), inset 0 0 0 6px rgba(192,255,0,0.4); }
      .a5 { padding: 0 44px; clip-path: polygon(12px 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%,0 12px); box-shadow: inset 0 0 0 1px rgba(192,255,0,0.8); }

      /* ===== Set B — unique hovers ===== */
      /* B1 fill wipe → invert */
      .b1 { box-shadow: inset 0 0 0 1px var(--lime); color: var(--lime); }
      .b1::before { content:''; position:absolute; inset:0; z-index:1; background: var(--lime); transform: scaleX(0); transform-origin:left; transition: transform .4s cubic-bezier(.16,1,.3,1); }
      .b1:hover { color: #05130a; }
      .b1:hover::before { transform: scaleX(1); }

      /* B2 spinning gradient edge */
      .b2 { background: #0f1113; border-radius: 10px; }
      .b2::before { content:''; position:absolute; inset:-150%; z-index:-1;
        background: conic-gradient(from 0deg, transparent 0 70%, var(--lime) 85%, var(--teal) 100%);
        animation: spin 3.5s linear infinite; opacity:0; transition: opacity .4s ease; }
      .b2::after { content:''; position:absolute; inset:1.5px; z-index:0; background:#0f1113; border-radius: 9px; }
      .b2:hover::before { opacity: 1; }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* B3 label slide-swap */
      .b3 { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.35); }
      .b3 span { transition: transform .4s cubic-bezier(.16,1,.3,1); }
      .b3 span::after { content: attr(data-txt); position: absolute; left: 0; top: 100%; width: 100%; color: var(--lime); }
      .b3:hover span { transform: translateY(-100%); }

      /* B4 pulsing glow ring */
      .b4 { box-shadow: inset 0 0 0 1px var(--teal); color: var(--teal); border-radius: 6px; }
      .b4:hover { color: #fff; animation: pulse 1.1s ease-in-out infinite; }
      @keyframes pulse {
        0%,100% { box-shadow: inset 0 0 0 1px var(--teal), 0 0 0 0 rgba(91,194,194,0.5); }
        50% { box-shadow: inset 0 0 0 1.5px var(--teal), 0 0 22px 4px rgba(91,194,194,0.45); }
      }

      /* B5 corner-bracket draw */
      .b5 { color: var(--lime); }
      .b5::before, .b5::after { content:''; position:absolute; width: 16px; height: 16px; border: 1.5px solid var(--lime); transition: width .4s ease, height .4s ease; }
      .b5::before { top:0; left:0; border-right:0; border-bottom:0; }
      .b5::after { bottom:0; right:0; border-left:0; border-top:0; }
      .b5:hover::before, .b5:hover::after { width: calc(100% - 2px); height: calc(100% - 2px); }

      @media (prefers-reduced-motion: reduce) {
        .btnA, .btnB, .hd-link { transition: none; }
        .b2::before, .b4:hover { animation: none; }
      }
    </style>
  </body>
</html>
