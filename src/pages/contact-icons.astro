---
/*
 * Contact-Kevin icon mockups — collapsed icons that expand on hover to reveal
 * "CONTACT KEVIN", opening WITHIN their shape. Two shape families so nothing
 * clashes with the site geometry:
 *   A) Rectangle  — matches the radial menu buttons (border-radius, neon edge)
 *   B) Honeycomb  — matches the hexagon background (elongates into a real cell)
 * Same 8 icons in each so you're comparing the shape. Pick a shape + number and
 * I'll wire it into Nav.astro. Lime neon (#C0FF00) to match the current nav.
 */
import '../styles/global.css';

// Feather-style icons, stroke = currentColor.
const svg: Record<number, string> = {
  1: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>`,
  2: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>`,
  3: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>`,
  4: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>`,
  5: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.9 7.9"/></svg>`,
  6: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  7: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>`,
  8: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
};

const items = [
  { n: 1, name: 'Envelope (mail)' },
  { n: 2, name: 'Phone handset' },
  { n: 3, name: 'Chat bubble' },
  { n: 4, name: 'Paper plane (send)' },
  { n: 5, name: 'At-sign' },
  { n: 6, name: 'Person' },
  { n: 7, name: 'Headset / call' },
  { n: 8, name: 'Calendar (book)' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact-Kevin icons — VALORA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@300;400;500&display=swap" />
  </head>
  <body class="bg-bg-base text-ink-primary font-sans">
    <main class="max-w-[1180px] mx-auto px-6 py-16">
      <p class="eyebrow">VALORA · Contact-Kevin icons</p>
      <h1 class="text-4xl md:text-5xl font-light leading-tight mb-3">Two shapes, eight icons each.</h1>
      <p class="text-ink-muted max-w-2xl mb-12">No circles — each icon opens on hover <b>within its shape</b> to reveal <b>CONTACT KEVIN</b>. Set A matches the menu buttons; Set B matches the honeycomb background. Hover to preview, then pick a set + number.</p>

      <h2 class="sec">A · Rectangle <span>— matches the menu buttons</span></h2>
      <div class="igrid">
        {items.map((it) => (
          <div class="icard">
            <div class="istage">
              <button type="button" class="ck rectck" aria-label="Contact Kevin">
                <span class="tx">Contact Kevin</span>
                <span class="ic" set:html={svg[it.n]} />
              </button>
            </div>
            <p class="iname"><b>A{it.n}.</b> {it.name}</p>
          </div>
        ))}
      </div>

      <h2 class="sec mt-16">B · Honeycomb <span>— matches the background</span></h2>
      <div class="igrid">
        {items.map((it) => (
          <div class="icard">
            <div class="istage">
              <button type="button" class="ck hexck" aria-label="Contact Kevin">
                <span class="fill"></span>
                <span class="tx">Contact Kevin</span>
                <span class="ic" set:html={svg[it.n]} />
              </button>
            </div>
            <p class="iname"><b>B{it.n}.</b> {it.name}</p>
          </div>
        ))}
      </div>
    </main>

    <style>
      :root { --lime: #C0FF00; --teal: #5BC2C2; --base: #0F0E0C; --ink: #EDE6D6; --stage: #131417; }
      .eyebrow { color: var(--lime); font-size: 12px; letter-spacing: 0.4em; text-transform: uppercase; margin-bottom: 12px; }
      .sec { font-family: var(--font-serif); font-weight: 400; font-size: 22px; margin-bottom: 20px; color: var(--ink); }
      .sec span { color: var(--ink-muted, #A29A8B); font-size: 14px; }
      .igrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 26px 20px; }
      .istage {
        height: 118px; border-radius: 14px; background: var(--stage);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);
        display: flex; align-items: center; justify-content: flex-end;
        padding-right: 22px;
      }
      .iname { margin-top: 11px; color: var(--ink); font-size: 13.5px; }
      .iname b { color: var(--lime); }

      /* shared: icon anchored right, label reveals to its left */
      .ck {
        position: relative; display: inline-flex; align-items: center;
        justify-content: flex-end; height: 46px; padding: 0;
        color: var(--lime); background: transparent; cursor: pointer;
        overflow: hidden;
        transition: width .55s cubic-bezier(.16,1,.3,1), box-shadow .4s ease;
      }
      .ck .ic { flex: 0 0 46px; width: 46px; height: 46px; display: grid; place-items: center; position: relative; z-index: 2; }
      .ck .ic svg { width: 19px; height: 19px; display: block; }
      .ck .tx {
        order: -1; white-space: nowrap; opacity: 0; position: relative; z-index: 2;
        font-size: 11.5px; letter-spacing: 0.16em; text-transform: uppercase;
        padding-left: 18px; transition: opacity .35s ease .12s;
      }
      .ck:hover .tx { opacity: 1; }
      .ck:focus-visible { outline: 2px solid var(--lime); outline-offset: 3px; }

      /* A — Rectangle (menu-button geometry) */
      .rectck { width: 46px; border-radius: 10px; border: 1.5px solid var(--lime); }
      .rectck:hover { width: 208px; box-shadow: 0 0 10px rgba(192,255,0,.28), 0 0 22px rgba(192,255,0,.16); }

      /* B — Honeycomb (elongating hexagon cell) */
      .hexck {
        width: 54px; background: var(--lime); /* lime shows through as the outline */
        clip-path: polygon(15px 0, calc(100% - 15px) 0, 100% 50%, calc(100% - 15px) 100%, 15px 100%, 0 50%);
      }
      .hexck .fill {
        content: ''; position: absolute; inset: 1.7px; z-index: 1; background: var(--stage);
        clip-path: polygon(15px 0, calc(100% - 15px) 0, 100% 50%, calc(100% - 15px) 100%, 15px 100%, 0 50%);
      }
      .hexck:hover { width: 214px; filter: drop-shadow(0 0 8px rgba(192,255,0,.4)); }
    </style>
  </body>
</html>
