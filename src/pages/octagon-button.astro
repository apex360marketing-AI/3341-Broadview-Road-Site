---
/*
 * Octagon "Contact Kevin" buttons — a MIX-AND-MATCH matrix. Two axes so you can
 * combine any pairing:
 *   Set M — the OPENING MOTION (how it animates open)
 *   Set L — the OPEN-STATE LOOK (how it appears once open)
 * All octagon-shaped with the brand compass inside. Tell me e.g. "M5 + L3".
 * MOCKUP ONLY — the live nav is untouched until a pick is approved.
 */
import '../styles/global.css';

const teal = '#5BC2C2', lime = '#C0FF00', cream = '#EDE6D6';
const RING = (r: number, o: any = {}) => {
  const { sw = 0.9, color = cream, op = 0.4 } = o;
  return `<circle cx="30" cy="30" r="${r}" fill="none" stroke="${color}" stroke-opacity="${op}" stroke-width="${sw}"/>`;
};
const FLIGHT = 'M30,30 L29.07,27.75 L30,13 Z M30,30 L30.93,27.75 L35.58,24.42 Z M30,30 L32.25,29.07 L47,30 Z M30,30 L32.25,30.93 L35.58,35.58 Z M30,30 L30.93,32.25 L30,47 Z M30,30 L29.07,32.25 L24.42,35.58 Z M30,30 L27.75,30.93 L13,30 Z M30,30 L27.75,29.07 L24.42,24.42 Z';
const FDARK  = 'M30,30 L30,13 L30.93,27.75 Z M30,30 L35.58,24.42 L32.25,29.07 Z M30,30 L47,30 L32.25,30.93 Z M30,30 L35.58,35.58 L30.93,32.25 Z M30,30 L30,47 L29.07,32.25 Z M30,30 L24.42,35.58 L27.75,30.93 Z M30,30 L13,30 L27.75,29.07 Z M30,30 L24.42,24.42 L29.07,27.75 Z';
const STAR = `<path d="${FLIGHT}" fill="${cream}"/><path d="${FDARK}" fill="${teal}"/>`;
const COMPASS = `${RING(28)}${RING(21)}<g class="spin">${STAR}</g>`;

const motions = [
  { id: 'M1',  name: 'Slide open (wipe)' },
  { id: 'M2',  name: 'Iris zoom' },
  { id: 'M3',  name: 'Letter cascade' },
  { id: 'M4',  name: 'Blur focus-in' },
  { id: 'M5',  name: 'Elastic overshoot' },
  { id: 'M6',  name: 'Typewriter' },
  { id: 'M7',  name: 'Skew slide' },
  { id: 'M8',  name: 'Flip up' },
];
const looks = [
  { id: 'L1', name: 'Ghost outline' },
  { id: 'L2', name: 'Solid lime fill' },
  { id: 'L3', name: 'Teal fill' },
  { id: 'L4', name: 'Lime→teal gradient' },
  { id: 'L5', name: 'Frosted glass' },
  { id: 'L6', name: 'Split two-tone' },
  { id: 'L7', name: 'Neon glow' },
  { id: 'L8', name: 'Conic gradient edge' },
];
const chars = 'Contact Kevin'.split('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Octagon buttons — VALORA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@300;400;500&display=swap" />
  </head>
  <body class="bg-bg-base text-ink-primary font-sans">
    <main class="max-w-[1180px] mx-auto px-6 py-16">
      <p class="eyebrow">VALORA · Octagon CTA · mix &amp; match</p>
      <h1 class="text-4xl md:text-5xl font-light leading-tight mb-3">Pick a motion, pick a look.</h1>
      <p class="text-ink-muted max-w-2xl mb-12">Every button is an octagon with the brand compass. <b>Set M</b> varies how it opens; <b>Set L</b> varies how it looks once open. Combine any two — e.g. <b>M5 + L3</b>. Hover to preview.</p>

      <h2 class="sec">Set M · Opening motion <span>— same ghost octagon, different animation</span></h2>
      <div class="ogrid">
        {motions.map((m) => (
          <div class="ocard">
            <div class="ostage">
              <button type="button" class={`ok oct L1 ${m.id.toLowerCase()}`} aria-label="Contact Kevin">
                <span class="fill"></span>
                <span class="tx">{chars.map((c) => (<span class="ch">{c === ' ' ? ' ' : c}</span>))}</span>
                <span class="ic"><svg viewBox="0 0 60 60" aria-hidden="true" set:html={COMPASS}></svg></span>
              </button>
            </div>
            <p class="oname"><b>{m.id}.</b> {m.name}</p>
          </div>
        ))}
      </div>

      <h2 class="sec mt-16">Set L · Open-state look <span>— same slide motion, different finish</span></h2>
      <div class="ogrid">
        {looks.map((l) => (
          <div class="ocard">
            <div class="ostage">
              <button type="button" class={`ok oct ${l.id} m1`} aria-label="Contact Kevin">
                <span class="fill"></span>
                <span class="tx"><span class="ch">Contact&#160;Kevin</span></span>
                <span class="ic"><svg viewBox="0 0 60 60" aria-hidden="true" set:html={COMPASS}></svg></span>
              </button>
            </div>
            <p class="oname"><b>{l.id}.</b> {l.name}</p>
          </div>
        ))}
      </div>
    </main>

    <style>
      :root { --lime:#C0FF00; --teal:#5BC2C2; --deep:#3FA6A6; --base:#0F0E0C; --ink:#EDE6D6; --stage:#131417; --ac:var(--lime); }
      .eyebrow { color:var(--lime); font-size:12px; letter-spacing:0.4em; text-transform:uppercase; margin-bottom:12px; }
      .sec { font-family:var(--font-serif); font-weight:400; font-size:22px; margin-bottom:20px; color:var(--ink); }
      .sec span { color:#A29A8B; font-size:14px; }
      .ogrid { display:grid; grid-template-columns:repeat(auto-fit, minmax(250px,1fr)); gap:28px 20px; }
      .ostage { height:126px; border-radius:14px; background:var(--stage); box-shadow:inset 0 0 0 1px rgba(255,255,255,0.06);
        display:flex; align-items:center; justify-content:flex-end; padding-right:24px; }
      .oname { margin-top:12px; color:var(--ink); font-size:13.5px; }
      .oname b { color:var(--lime); }

      /* octagon base */
      .ok {
        position:relative; display:inline-flex; align-items:center; justify-content:flex-end;
        height:54px; width:54px; padding:0; color:var(--ink); background:var(--ac); cursor:pointer;
        clip-path:polygon(15px 0, calc(100% - 15px) 0, 100% 15px, 100% calc(100% - 15px), calc(100% - 15px) 100%, 15px 100%, 0 calc(100% - 15px), 0 15px);
        transition: width .6s cubic-bezier(.16,1,.3,1), filter .4s ease;
      }
      .ok .fill { display:block; position:absolute; inset:1.8px; z-index:1; background:var(--stage);
        clip-path:polygon(15px 0, calc(100% - 15px) 0, 100% 15px, 100% calc(100% - 15px), calc(100% - 15px) 100%, 15px 100%, 0 calc(100% - 15px), 0 15px); }
      .ok .ic { flex:0 0 54px; width:54px; height:54px; display:grid; place-items:center; position:relative; z-index:3; }
      .ok .ic svg { width:34px; height:34px; overflow:visible; filter:drop-shadow(0 1px 3px rgba(0,0,0,0.5)); }
      .ok .tx { order:-1; position:relative; z-index:3; white-space:nowrap; padding-left:16px;
        font-size:11.5px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ac); }
      .ok:hover { width:218px; }
      .ok:focus-visible { outline:2px solid var(--ac); outline-offset:3px; }
      .ok .spin { transform-box:fill-box; transform-origin:center; animation:ospin 12s linear infinite; }
      .ok:hover .spin { animation-duration:2.6s; }
      @keyframes ospin { to { transform:rotate(360deg); } }

      /* ============ Set M — OPENING MOTION (text entrance) ============ */
      /* default hidden state for text */
      .m1 .tx, .m2 .tx, .m3 .ch, .m4 .tx, .m5 .tx, .m6 .tx, .m7 .tx, .m8 .tx { opacity:0; }

      /* M1 slide wipe */
      .m1 .tx { clip-path:inset(0 100% 0 0); transition:opacity .3s ease .12s, clip-path .55s cubic-bezier(.16,1,.3,1) .1s; }
      .m1:hover .tx { opacity:1; clip-path:inset(0 0 0 0); }

      /* M2 iris zoom */
      .m2 .tx { transform:scale(.55); transform-origin:left center; transition:opacity .3s ease .1s, transform .5s cubic-bezier(.16,1,.3,1) .1s; }
      .m2:hover .tx { opacity:1; transform:scale(1); }

      /* M3 letter cascade */
      .m3 .ch { display:inline-block; opacity:0; transform:translateY(6px); transition:opacity .3s ease, transform .3s cubic-bezier(.16,1,.3,1); }
      .m3:hover .ch { opacity:1; transform:translateY(0); }
      .m3:hover .ch:nth-child(1){transition-delay:.12s}.m3:hover .ch:nth-child(2){transition-delay:.15s}.m3:hover .ch:nth-child(3){transition-delay:.18s}.m3:hover .ch:nth-child(4){transition-delay:.21s}.m3:hover .ch:nth-child(5){transition-delay:.24s}.m3:hover .ch:nth-child(6){transition-delay:.27s}.m3:hover .ch:nth-child(7){transition-delay:.30s}.m3:hover .ch:nth-child(8){transition-delay:.33s}.m3:hover .ch:nth-child(9){transition-delay:.36s}.m3:hover .ch:nth-child(10){transition-delay:.39s}.m3:hover .ch:nth-child(11){transition-delay:.42s}.m3:hover .ch:nth-child(12){transition-delay:.45s}.m3:hover .ch:nth-child(13){transition-delay:.48s}
      .m3 .tx { opacity:1; }

      /* M4 blur focus-in */
      .m4 .tx { filter:blur(6px); transition:opacity .4s ease .12s, filter .5s ease .12s; }
      .m4:hover .tx { opacity:1; filter:blur(0); }

      /* M5 elastic overshoot */
      .m5 { transition:width .7s cubic-bezier(.34,1.56,.64,1), filter .4s ease; }
      .m5 .tx { transform:translateX(14px) scale(.9); transition:opacity .3s ease .14s, transform .6s cubic-bezier(.34,1.56,.64,1) .12s; }
      .m5:hover .tx { opacity:1; transform:translateX(0) scale(1); }

      /* M6 typewriter (reveal by width, steps) */
      .m6 .tx { overflow:hidden; width:0; opacity:1; border-right:1.5px solid var(--ac); transition:width .55s steps(13, end) .12s; }
      .m6:hover .tx { width:132px; }

      /* M7 skew slide */
      .m7 .tx { transform:translateX(20px) skewX(-14deg); transition:opacity .35s ease .1s, transform .55s cubic-bezier(.16,1,.3,1) .1s; }
      .m7:hover .tx { opacity:1; transform:translateX(0) skewX(0); }

      /* M8 flip up */
      .m8 .tx { transform:rotateX(90deg); transform-origin:bottom; transition:opacity .3s ease .12s, transform .55s cubic-bezier(.16,1,.3,1) .12s; }
      .m8:hover .tx { opacity:1; transform:rotateX(0); }

      /* ============ Set L — OPEN-STATE LOOK ============ */
      /* L1 ghost outline (default: stage fill visible, lime edge) */
      .L1 { }
      /* L2 solid lime fill */
      .L2 { --ac:var(--lime); }
      .L2 .fill { display:none; }
      .L2 .tx { color:var(--base); }
      .L2 .ic svg circle { stroke:var(--base); }
      /* L3 teal fill */
      .L3 { --ac:var(--teal); }
      .L3 .fill { display:none; }
      .L3 .tx { color:var(--base); }
      /* L4 lime→teal gradient fill */
      .L4 { --ac:var(--lime); background:linear-gradient(100deg, var(--teal), var(--lime)); }
      .L4 .fill { display:none; }
      .L4 .tx { color:var(--base); }
      /* L5 frosted glass */
      .L5 { --ac:var(--teal); background:rgba(255,255,255,0.10); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); }
      .L5 .fill { inset:1.4px; background:rgba(19,20,23,0.55); }
      .L5 .tx { color:var(--ink); }
      /* L6 split two-tone — icon side filled, label side ghost */
      .L6 { --ac:var(--lime); background:var(--lime); }
      .L6 .fill { display:block; inset:1.8px; right:auto; width:calc(100% - 54px);
        clip-path:polygon(15px 0, 100% 0, 100% 100%, 15px 100%, 0 calc(100% - 15px), 0 15px); background:var(--stage); }
      .L6 .tx { color:var(--lime); }
      /* L7 neon glow */
      .L7 { --ac:var(--lime); }
      .L7:hover { filter:drop-shadow(0 0 6px var(--lime)) drop-shadow(0 0 14px rgba(192,255,0,.5)); }
      /* L8 conic gradient edge */
      .L8 { --ac:var(--lime); background:conic-gradient(from var(--a), var(--teal), var(--lime), var(--deep), var(--teal)); }
      @property --a { syntax:'<angle>'; inherits:false; initial-value:0deg; }
      .L8:hover { animation:oconic 2.6s linear infinite; }
      @keyframes oconic { to { --a:360deg; } }

      /* fill glow for outline looks */
      .oct:hover { filter:drop-shadow(0 0 6px color-mix(in srgb, var(--ac) 45%, transparent)); }

      @media (prefers-reduced-motion: reduce) { .ok .spin { animation:none; } }
    </style>
  </body>
</html>
